#!/bin/sh

${CVI_SHOPTS}
for SCRIPT in /etc/init.d/S??*; do
    [ -f "$SCRIPT" ] || continue
    if [ -e /run/bf01-preview/early-started ]; then
        case "$SCRIPT" in
            */S20network|*/S23ntp|*/S24cvidaemon|*/S50dropbear) continue ;;
        esac
    fi
    case "$SCRIPT" in
        *.sh) (trap - INT QUIT TSTP; set start; . "$SCRIPT") ;;
        *) "$SCRIPT" start ;;
    esac
done
