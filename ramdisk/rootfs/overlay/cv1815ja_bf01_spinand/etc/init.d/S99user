#!/bin/sh
${CVI_SHOPTS}
#
# Start firmware
#

export USERDATAPATH=/mnt/data/

kernel_start_ms() {
    _w=$(devmem 0x0e000024 32)
    echo $(( (_w >> 16) & 0xffff ))
}

uptime_ms() {
    awk '{printf "%d", $1 * 1000}' /proc/uptime
}

# Absolute time in ms since power-on, comparable with /tmp/boottime: the SPL
# records kernel_start in the high half of 0x0E000024 and /proc/uptime counts
# from the kernel clocksource init.
boot_ms() {
    echo $(( $(kernel_start_ms) + $(uptime_ms) ))
}

boot_log() {
    echo "$1"
    echo "S99user: $1" > /dev/kmsg
}

export SYSTEMPATH=/system/

case "$1" in
  start)
        boot_log "enter at $(boot_ms)ms (kernel_start=$(kernel_start_ms)ms)"
        echo "init mpp system..."
        if [ -f $SYSTEMPATH/ko/loadsystemko.sh ]; then
                sh $SYSTEMPATH/ko/loadsystemko.sh
        fi
        boot_log "ko loaded at $(boot_ms)ms"

        boot_log "start app at $(boot_ms)ms"
        echo "Starting app..."
        if [ -f $USERDATAPATH/auto.sh ]; then
                usleep 30000
                . $USERDATAPATH/auto.sh &
                exit 1
        fi
        if [ -f $SYSTEMPATH/auto.sh ]; then
                usleep 30000
                . $SYSTEMPATH/auto.sh &
        fi

        # record alios log
        # alios_cli -m 1 -c 0 2>&1 | logger -t alios -p local7.info &

        # run app
        # if [ -f $USERDATAPATH/bin/sophcam ]; then
        #         chmod +x $USERDATAPATH/bin/sophcam
        #         $USERDATAPATH/bin/sophcam </dev/null 2>&1 | logger -t sophcam &
        # fi

        # run wpa_supplicant after app start
        # wpa_supplicant -D nl80211 -i wlan0 -c /etc/wpa_supplicant.conf -B
        # ifconfig wlan0 down
	    # wifi-daemon -l info | logger -t wifi &
        ;;
  stop)
        if [ -x /mnt/system/wifi/wifi.sh ]; then
                /mnt/system/wifi/wifi.sh shutdown
        fi
        ;;
  restart|reload)
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
