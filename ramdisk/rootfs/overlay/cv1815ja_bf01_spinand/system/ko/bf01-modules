#!/bin/sh

set -eu
mkdir -p /run/bf01-preview
exec 9>/run/bf01-preview/modules.lock
flock 9
case "${1:-core}" in
    core) MODULES='cv181x_sys cvi_ipcm cv181x_wdt' ;;
    ai) MODULES='cv181x_tpu' ;;
    late) MODULES='cv181x_clock_cooling cv181x_ive' ;;
    *) exit 2 ;;
esac
for MODULE in $MODULES; do
    [ ! -e /run/bf01-poweroff/requested ] || exit 1
    if [ "${1:-core}" = ai ]; then
        [ ! -e /run/ipcamera-wifi/boot-media-cancelled ] || exit 125
        [ ! -e /run/ipcamera-wifi/live-mode ] || exit 125
    fi
    [ ! -d "/sys/module/$MODULE" ] || continue
    # The driver may be built into the kernel under another module name
    # (cv181x_wdt is cvi_wdt, cv181x_tpu/ive/clock_cooling have no sysfs entry),
    # in which case the .ko file is gone and there is nothing to load.
    [ -f "/mnt/system/ko/$MODULE.ko" ] || continue
    insmod "/mnt/system/ko/$MODULE.ko"
done
