<physical_partition type="spinand">
    <!--Uboot will ues 9th block to store a back up of fip.bin.
    Please keep the first 2.5MB reserved for fip and fip size less than 1.25MB-->
    <partition label="fip" size_in_kb="2560" file="fip_spl.bin"/>
    <partition label="2nd" size_in_kb="3072" readonly="false" file="yoc.bin"/>
    <!--A/B slots boot_a/boot_b + rootfs_a/rootfs_b. "misc" holds the A/B metadata (AvbABData) that
        u-boot SPL reads to pick the slot and that Linux update_misc modifies (CONFIG_AB_SYSTEM).
        Without CONFIG_AB_SYSTEM the slot is fixed at build time ("Enable b system" -> slot B).-->
    <partition label="boot_a" size_in_kb="8192" file="boot.spinand"/>
    <partition label="boot_b" size_in_kb="8192" file="boot_b.spinand"/>
    <!--No ENV partition: u-boot uses the built-in default env (CONFIG_ENV_IS_NOWHERE).
        No CFG partition: no cfg image, no ISP tuning bins (/mnt/cfg stays empty).-->
    <partition label="misc" size_in_kb="512" file="misc.spinand"/>
    <partition label="rootfs_a" size_in_kb="40960" file="rootfs.spinand" />
    <partition label="rootfs_b" size_in_kb="40960" file="rootfs_b.spinand" />
    <partition label="SYSTEM" size_in_kb="40960" file="system.spinand" mountpoint="" type="ubifs" />
    <partition label="DATA" size_in_kb="112768" file="data.spinand" mountpoint="/mnt/data" type="ubifs" />
</physical_partition>
