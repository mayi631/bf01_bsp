From 2c5c54ae8f61208a40409b9afcfc4bd8bbff5cbf Mon Sep 17 00:00:00 2001
From: "xiu.yang" <xiu.yang@sophgo.com>
Date: Tue, 17 Nov 2026 10:44:29 +0800
Subject: [PATCH] fix(cost_time): always build the time record helpers and
 widen them to 64 bits

[description ]:
- kernel/Makefile: build cost_time.o unconditionally (obj-y) instead of
  gating it on CONFIG_CVITEK_FASTBOOT.
- include/linux/cost_time.h: add the 14th time record field
  user_process_init_start, mark time_records with
  __attribute__((unused)), change read_count_tick() and read_time_ms()
  to uint64_t and declare read_time_us().
- kernel/cost_time.c: return uint64_t, convert us to ms with do_div()
  instead of DIV_ROUND_UP(), add read_time_us() and export both helpers.
- init/main.c: run_init_process() records kernel_run_init_start and
  user_process_init_start unconditionally, using two separate 16-bit
  stores so the high half of a 32-bit word does not land in the
  neighboring field.
- drivers/soc/cvitek/tick/cvi_tick_time.c: format read_time_ms() with
  %llu to match the new return type.

[root   cause]:
- /etc/init.d/P99boottime reads 14 fields from the time record area at
  0x0E000010, but struct _time_records only defined 13, so
  user_process_init_start came from memory outside the structure.
- The kernel write of kernel_run_init_start was wrapped in
  #ifdef CONFIG_CVITEK_FASTBOOT, and BF01 leaves that option unset, so
  neither the write nor cost_time.o was built and both fields stayed 0ms.
- read_count_tick() and read_time_ms() returned unsigned int while the
  counter is 64-bit; on a long-running system the tick value is truncated
  and DIV_ROUND_UP adds to it before the division, which can overflow.

[JIRA      ID]:TBD-BF01-BOOTTIME (to be provided)
[chip project]:181x
[side effects]:
- read_time_ms()/read_time_us() now return uint64_t; in-tree callers
  (init/main.c, cvi_tick_time.c) were updated. Out-of-tree modules using
  the old unsigned int return need a matching update.
- /proc/tick remains absent because CVI_TICK_TIME still depends on
  CVITEK_FASTBOOT, which BF01 does not enable.
- Verified on cv1815ja_bf01_spinand: clean_kernel/build_kernel builds
  without warnings; /tmp/boottime reports kernel_run_init_start and
  user_process_init_start at 12746/12766ms across two boots.

[Affected *.ko/*.so/*.a] :built-in kernel/cost_time.o; no loadable .ko/.so/.a

Change-Id: I7c1d9e2a4b8f3c60d5e7a91b2f4c8d36a0e5b719
---
 drivers/soc/cvitek/tick/cvi_tick_time.c |  2 +-
 include/linux/cost_time.h               | 11 +++++++----
 init/main.c                             | 23 ++++++++++++++++++-----
 kernel/Makefile                         |  2 +-
 kernel/cost_time.c                      | 17 ++++++++++++++---
 5 files changed, 41 insertions(+), 14 deletions(-)

diff --git a/drivers/soc/cvitek/tick/cvi_tick_time.c b/drivers/soc/cvitek/tick/cvi_tick_time.c
index d4d5e3ba497d3ba11b19c5ba0772dbfa135a96ad..0a7cd7fef09d7ed3a4e6ad2a8e010a3124a4a49b 100644
--- a/drivers/soc/cvitek/tick/cvi_tick_time.c
+++ b/drivers/soc/cvitek/tick/cvi_tick_time.c
@@ -11,7 +11,7 @@
 
 static int tick_time_proc_show(struct seq_file *m, void *v)
 {
-	seq_printf(m, "%u", read_time_ms());
+	seq_printf(m, "%llu", read_time_ms());
 	return 0;
 }
 
diff --git a/include/linux/cost_time.h b/include/linux/cost_time.h
index e6bd88f1a15fa309927e6a1e7608f4fc2683b986..0851e645f13f0f95cf0f4aed16c291b376831ecb 100644
--- a/include/linux/cost_time.h
+++ b/include/linux/cost_time.h
@@ -16,10 +16,11 @@ struct _time_records {
 	uint16_t decompress_kernel_start;
 	uint16_t kernel_start;
 	uint16_t kernel_run_init_start;
+	uint16_t user_process_init_start;
 } __packed;
 
 #define TIME_RECORDS_ADDR 0x0E000010
-static struct _time_records *time_records =
+static struct _time_records *time_records __attribute__((unused)) =
 	(struct _time_records *)TIME_RECORDS_ADDR;
 
 #define SYS_COUNTER_FREQ_IN_US 25
@@ -30,10 +31,12 @@ static struct _time_records *time_records =
 		__tmp;                                                         \
 	})
 
-unsigned int read_count_tick(void);
+uint64_t read_count_tick(void);
 
-unsigned int read_time_ms(void);
+uint64_t read_time_ms(void);
+
+uint64_t read_time_us(void);
 
 void print_cost_time(unsigned int rettime, const char *func);
 
-#endif /* COST_TIME_H */
\ No newline at end of file
+#endif /* COST_TIME_H */
diff --git a/init/main.c b/init/main.c
index ccde369985c86b7c1baf687a4a37aad404554952..2d6873b1288b64e21f8f362c6b161566616e2e40 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1352,11 +1352,24 @@ static int run_init_process(const char *init_filename)
 	for (p = envp_init; *p; p++)
 		pr_debug("    %s\n", *p);
 
-#ifdef CONFIG_CVITEK_FASTBOOT
-	uint16_t *t_addr = ioremap(&time_records->kernel_run_init_start, 4);
-	*t_addr = read_time_ms();
-	iounmap(t_addr);
-#endif
+	/*
+	 * Save kernel init time before the first user process starts.
+	 * /etc/init.d/P99boottime reads kernel_run_init_start and
+	 * user_process_init_start back from TIME_RECORDS_ADDR.
+	 * The two 16-bit fields are written separately: a single 32-bit store
+	 * would put (read_time_ms() >> 16) into user_process_init_start.
+	 */
+	{
+		uint16_t *t_addr = ioremap(&time_records->kernel_run_init_start, 4);
+
+		if (t_addr) {
+			uint16_t now = read_time_ms();
+
+			t_addr[0] = now;	/* kernel_run_init_start */
+			t_addr[1] = now;	/* user_process_init_start */
+			iounmap(t_addr);
+		}
+	}
 
 	early_time_log(__func__);
 	return kernel_execve(init_filename, argv_init, envp_init);
diff --git a/kernel/Makefile b/kernel/Makefile
index 2fb3d80d33d0f88d669cd9ae0f7b87d5b6b246d0..7a6d4d97e598b99b0435a406fa854ed0258c6cc1 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -12,7 +12,7 @@ obj-y     = fork.o exec_domain.o panic.o \
 	    notifier.o ksysfs.o cred.o reboot.o \
 	    async.o range.o smpboot.o ucount.o regset.o
 
-obj-$(CONFIG_CVITEK_FASTBOOT) += cost_time.o
+obj-y += cost_time.o
 obj-$(CONFIG_USERMODE_DRIVER) += usermode_driver.o
 obj-$(CONFIG_MODULES) += kmod.o
 obj-$(CONFIG_MULTIUSER) += groups.o
diff --git a/kernel/cost_time.c b/kernel/cost_time.c
index 32fd69c7bd3670c64ecc552aa5a0783451205451..4a984febb9a8ea6db92514a93e1188576abc9cdc 100644
--- a/kernel/cost_time.c
+++ b/kernel/cost_time.c
@@ -4,7 +4,7 @@
 #include <asm/arch_timer.h>
 #endif
 
-unsigned int read_count_tick(void)
+uint64_t read_count_tick(void)
 {
 #if defined(CONFIG_ARM) || defined(__arm__) || defined(__aarch64__)
 	u64 c = __arch_counter_get_cntpct();
@@ -19,10 +19,21 @@ unsigned int read_count_tick(void)
 #endif
 }
 
-unsigned int read_time_ms(void)
+uint64_t read_time_us(void)
 {
-	return DIV_ROUND_UP(read_count_tick(), 1000);
+	return read_count_tick();
 }
+EXPORT_SYMBOL(read_time_us);
+
+uint64_t read_time_ms(void)
+{
+	u64 us = read_count_tick();
+	u64 ms = us;
+
+	do_div(ms, 1000);
+	return ms;
+}
+EXPORT_SYMBOL(read_time_ms);
 
 /**
  * @brief print cost time
-- 
2.25.1

