From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mayi <3363523343@qq.com>
Date: Thu, 5 Nov 2026 15:10:00 +0800
Subject: [PATCH] fix(ion): exclude RTOS reservation from the carveout allocator

The driver adjusts the zeroing range but still registers the original full
region in gen_pool and reports its original size. Register the adjusted
base and size so Linux allocations cannot overlap the RTOS reservation.
Reject invalid reservation sizes and clean up a failed gen_pool_add.

---
diff --git a/drivers/staging/android/ion/ion_carveout_heap.c b/drivers/staging/android/ion/ion_carveout_heap.c
index 7b1df5779fc4..a8a264746382 100644
--- a/drivers/staging/android/ion/ion_carveout_heap.c
+++ b/drivers/staging/android/ion/ion_carveout_heap.c
@@ -127,9 +127,7 @@ void cvi_get_rtos_ion_size(size_t *psize)
 	}
 
 	ret = of_property_read_u32(np, "ion-size", &rtos_ion_size);
-	*psize = rtos_ion_size;
-	if(ret)
-		*psize = 0;
+	*psize = ret ? 0 : rtos_ion_size;
 
 	of_node_put(np);
 
@@ -152,6 +150,7 @@ struct ion_heap *ion_carveout_heap_create(struct ion_platform_heap *heap_data)
 
 	struct page *page;
 	size_t size;
+	phys_addr_t base = heap_data->base;
 #ifdef CONFIG_ION_CVITEK
 	size_t rtos_ion_size;
 	struct page *rtos_end_page;
@@ -167,9 +166,15 @@ struct ion_heap *ion_carveout_heap_create(struct ion_platform_heap *heap_data)
 	/* cvitek: freertos will use this space before linux boot up, we shouldn't modify it. */
 	cvi_get_rtos_ion_size(&rtos_ion_size);
 	if(rtos_ion_size){
+		if (rtos_ion_size >= size || PAGE_ALIGN(rtos_ion_size) >= size) {
+			pr_err("%s: invalid RTOS reservation %zu for heap size %zu\n",
+			       __func__, rtos_ion_size, size);
+			return ERR_PTR(-EINVAL);
+		}
 		heap_end_addr = heap_data->base + size;
 		rtos_end_page = pfn_to_page(PFN_UP(heap_data->base + rtos_ion_size));
-		size = heap_end_addr - page_to_phys(rtos_end_page);
+		base = page_to_phys(rtos_end_page);
+		size = heap_end_addr - base;
 		page = rtos_end_page;
 		pr_info("%s, size(exclusion of rtos_ion_size)=0x%lx\n", __func__, size);
 	}
@@ -192,9 +197,13 @@ struct ion_heap *ion_carveout_heap_create(struct ion_platform_heap *heap_data)
 	}
 
 	gen_pool_set_algo(carveout_heap->pool, gen_pool_best_fit, NULL);
-	carveout_heap->base = heap_data->base;
-	gen_pool_add(carveout_heap->pool, carveout_heap->base, heap_data->size,
-		     -1);
+	carveout_heap->base = base;
+	ret = gen_pool_add(carveout_heap->pool, carveout_heap->base, size, -1);
+	if (ret) {
+		gen_pool_destroy(carveout_heap->pool);
+		kfree(carveout_heap);
+		return ERR_PTR(ret);
+	}
 	carveout_heap->heap.ops = &carveout_heap_ops;
 	carveout_heap->heap.type = ION_HEAP_TYPE_CARVEOUT;
 #ifndef CONFIG_ION_CVITEK
@@ -202,7 +211,7 @@ struct ion_heap *ion_carveout_heap_create(struct ion_platform_heap *heap_data)
 #endif
     carveout_heap->heap.name = heap_data->name;
 #ifdef CONFIG_ION_CVITEK
-	carveout_heap->heap.total_size = heap_data->size;
+	carveout_heap->heap.total_size = size;
 #endif
 	return &carveout_heap->heap;
 }
