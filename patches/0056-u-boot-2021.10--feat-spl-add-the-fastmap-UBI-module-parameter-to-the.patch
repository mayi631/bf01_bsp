From 0ee045d010c6eb66741d1e2a616070bf756985f2 Mon Sep 17 00:00:00 2001
From: "xiu.yang" <xiu.yang@sophgo.com>
Date: Thu, 19 Nov 2026 15:19:53 +0800
Subject: [PATCH] feat(spl): add the fastmap UBI module parameter to the fast
 boot command line

[description ]:
- Define CONFIG_UBI_FASTMAP_AUTOCONVERT in cvitek.mk when the board packs
  its rootfs UBI image with room for a fastmap (build/Kconfig
  ROOTFS_UBI_FM_RESERVE is non-zero).
- Expand UBI_FM_ARGS to " ubi.fm_autoconvert=1" under that macro and append
  it to all three ROOTARGS_FOR() variants, so the kernel writes a fastmap
  for the rootfs device.
- Whitelist the new macro, otherwise the u-boot config checker rejects the
  -D with "You must add new CONFIG options using Kconfig".

[root   cause]:
- The fast boot path builds the kernel command line from ROOTARGS_FOR()
  and had no way to pass UBI module parameters, so a rootfs image packed
  with free PEBs still attached by scanning every block.
- fm_autoconvert is global: userland clears it before attaching the DATA
  volume, which is generated by create_automount.py in the build tree.

[JIRA      ID]:TBD-BF01-BOOTTIME
[chip project]:181x
[side effects]:
- Boards that do not set ROOTFS_UBI_FM_RESERVE get an empty UBI_FM_ARGS
  and an unchanged command line.
- Verified on cv1815ja_bf01_spinand: the SPL bootargs string contains
  ubi.fm_autoconvert=1, the kernel reports "ubi0: attached by fastmap" on
  the second boot, and the system boots, mounts rootfs and DATA, and runs
  three RTSP streams normally.

[Affected *.ko/*.so/*.a] :none, u-boot header and build variable only

Change-Id: I7a2f5d0e8c41b3d6a9e04c75f1b8d2e63a90c4f6
---
 cvitek.mk                     |  6 ++++++
 include/configs/cv181x-asic.h | 15 ++++++++++++---
 scripts/config_whitelist.txt  |  1 +
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/cvitek.mk b/cvitek.mk
index c90180ea6d..bdad93f990 100644
--- a/cvitek.mk
+++ b/cvitek.mk
@@ -20,6 +20,12 @@ ifeq (${CONFIG_AB_SYSTEM},y)
 KBUILD_CPPFLAGS += -DCONFIG_AB_SYSTEM=1
 endif
 
+# build/Kconfig "ROOTFS options -> Free PEBs reserved ... for fastmap": the rootfs
+# UBI image leaves room for a fastmap, so ask the kernel to write one.
+ifneq ($(filter-out 0,$(strip ${CONFIG_ROOTFS_UBI_FM_RESERVE})),)
+KBUILD_CPPFLAGS += -DCONFIG_UBI_FASTMAP_AUTOCONVERT=1
+endif
+
 ifeq (${CONFIG_BUILD_FOR_DEBUG},y)
 KBUILD_CPPFLAGS += -DCONFIG_BUILD_FOR_DEBUG=${CONFIG_BUILD_FOR_DEBUG}
 endif
diff --git a/include/configs/cv181x-asic.h b/include/configs/cv181x-asic.h
index a748a5b63e..b3e8dc9060 100644
--- a/include/configs/cv181x-asic.h
+++ b/include/configs/cv181x-asic.h
@@ -231,14 +231,23 @@
 			#define ROOTFS_SLOT ROOTFS_DEV
 			#define BOOT_SLOT BOOT_DEV
 		#endif
+		/* The rootfs UBI image was packed with free PEBs for a fastmap (build/Kconfig
+		 * ROOTFS_UBI_FM_RESERVE), so let the kernel write one. fm_autoconvert is a
+		 * global module parameter: userland must clear it before attaching any UBI
+		 * device that was not packed with room for a fastmap. */
+		#ifdef CONFIG_UBI_FASTMAP_AUTOCONVERT
+			#define UBI_FM_ARGS " ubi.fm_autoconvert=1"
+		#else
+			#define UBI_FM_ARGS ""
+		#endif
 		#ifdef CONFIG_SKIP_RAMDISK
 			#ifdef CONFIG_ROOTFS_RW
-				#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0 rw root=ubi0:" dev " rootfstype=ubifs"
+				#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0 rw root=ubi0:" dev " rootfstype=ubifs" UBI_FM_ARGS
 			#else
-				#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0 root=/dev/ubiblock0_0 rootfstype=squashfs"
+				#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0 root=/dev/ubiblock0_0 rootfstype=squashfs" UBI_FM_ARGS
 			#endif
 		#else
-			#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0"
+			#define ROOTARGS_FOR(dev) "ubi.mtd=" dev " ubi.block=0,0" UBI_FM_ARGS
 		#endif /* CONFIG_SKIP_RAMDISK */
 		/* static slot (also the env default before ab_select runs) */
 		#define ROOTARGS ROOTARGS_FOR(ROOTFS_SLOT)
diff --git a/scripts/config_whitelist.txt b/scripts/config_whitelist.txt
index edd39de133..2bf6e62c1c 100644
--- a/scripts/config_whitelist.txt
+++ b/scripts/config_whitelist.txt
@@ -3361,6 +3361,7 @@ CONFIG_TX_DESCR_NUM
 CONFIG_TZSW_RESERVED_DRAM_SIZE
 CONFIG_UBIBLOCK
 CONFIG_UBIFS_VOLUME
+CONFIG_UBI_FASTMAP_AUTOCONVERT
 CONFIG_UBI_PART
 CONFIG_UBI_SIZE
 CONFIG_UBOOTPATH
