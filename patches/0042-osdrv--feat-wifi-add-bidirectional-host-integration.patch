+#ifdef ATBM_BF01_STARTUP_RETRY
+static ssize_t bf01_startup_state_show(struct device *dev,
+		struct device_attribute *attribute, char *buffer)
+{
+	struct sbus_priv *self = atbm_sdio_get_drvdata(dev_to_sdio_func(dev));
+	const char *state;
+	int status;
+
+	if (!self)
+		return -ENODEV;
+	status = READ_ONCE(self->startup_error);
+	if (atbm_bf01_startup_cancelled(self))
+		state = "stopped";
+	else if (smp_load_acquire(&self->startup_ready))
+		state = "ready";
+	else if (status == -EINPROGRESS)
+		state = "handshaking";
+	else
+		state = "retry";
+	return scnprintf(buffer, PAGE_SIZE, "%s attempt=%u error=%d\n", state,
+		READ_ONCE(self->startup_attempts), status);
+}
+static DEVICE_ATTR_RO(bf01_startup_state);
+
+static int atbm_bf01_prepare_function(struct sbus_priv *self)
+{
+	struct sdio_func *func = self->func;
+	u8 bus_interface, expected_width, enabled, ready;
+	int status;
+
+	sdio_claim_host(func);
+	bus_interface = sdio_f0_readb(func, SDIO_CCCR_IF, &status);
+	sdio_release_host(func);
+	if (status)
+		return status;
+	expected_width = func->card->host->ios.bus_width == MMC_BUS_WIDTH_4 ?
+		SDIO_BUS_WIDTH_4BIT : SDIO_BUS_WIDTH_1BIT;
+	if ((bus_interface & SDIO_BUS_WIDTH_MASK) != expected_width) {
+		atbm_printk_err("BF01 handshake bus configuration changed: host=%u IF=0x%02x; restoring SDIO communications\n",
+			func->card->host->ios.bus_width, bus_interface);
+		status = sdio_reset_comm(func->card);
+		if (status)
+			return status;
+	}
+	sdio_claim_host(func);
+	status = atbm_sdio_enable_func(func);
+	if (!status)
+		status = sdio_set_block_size(func, SDIO_BLOCK_SIZE);
+	if (!status) {
+		enabled = sdio_f0_readb(func, SDIO_CCCR_IOEx, &status);
+		if (!status) {
+			ready = sdio_f0_readb(func, SDIO_CCCR_IORx, &status);
+			if (!status && (!(enabled & BIT(func->num)) ||
+					!(ready & BIT(func->num))))
+				status = -EAGAIN;
+		}
+	}
+	sdio_release_host(func);
+	return status;
+}
+
+static void atbm_bf01_startup_work(struct work_struct *work)
+{
+	struct sbus_priv *self = container_of(to_delayed_work(work),
+		struct sbus_priv, startup_work);
+	unsigned int attempt;
+	int status;
+
+	if (atbm_bf01_startup_cancelled(self) ||
+	    smp_load_acquire(&self->startup_ready))
+		return;
+	attempt = READ_ONCE(self->startup_attempts) + 1;
+	WRITE_ONCE(self->startup_attempts, attempt);
+	WRITE_ONCE(self->startup_error, -EINPROGRESS);
+	atomic_set(&self->startup_irq_count, 0);
+	atomic_set(&self->startup_rx_count, 0);
+	self->startup_poll_count = 0;
+	self->io_error_logged = 0;
+	atbm_printk_always("BF01 handshake attempt=%u: preparing function and requesting real WSM startup\n", attempt);
+	status = atbm_bf01_prepare_function(self);
+	if (!status && !atbm_bf01_startup_cancelled(self))
+		status = atbm_core_probe(&atbm_sdio_sbus_ops,
+			self, &self->func->dev, &self->core);
+	else if (!status)
+		status = -ESHUTDOWN;
+	WRITE_ONCE(self->startup_error, status);
+	if (!status) {
+		smp_store_release(&self->startup_ready, true);
+		atomic_set(&g_wtd.wtd_probe, 1);
+		atbm_printk_always("BF01 handshake ready: attempt=%u; wlan0 and control backend available\n", attempt);
+		return;
+	}
+	sdio_claim_host(self->func);
+	atbm_sdio_disable_func(self->func);
+	sdio_release_host(self->func);
+	if (!atbm_bf01_startup_cancelled(self)) {
+		atbm_printk_err("BF01 handshake failed: attempt=%u error=%d; retry_in_ms=1000; driver remains bound\n",
+			attempt, status);
+		queue_delayed_work(system_long_wq, &self->startup_work,
+			msecs_to_jiffies(1000));
+	}
+}
