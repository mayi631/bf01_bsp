 static int atbm_sdio_probe(struct sdio_func *func,
 			      const struct sdio_device_id *id)
 {
 	struct sbus_priv *self;
 	int status;
+#ifdef LINUX_OS
+	u8 bus_interface;
+	u8 expected_width;
+
+	sdio_claim_host(func);
+	bus_interface = sdio_f0_readb(func, SDIO_CCCR_IF, &status);
+	sdio_release_host(func);
+	if (status)
+		return status;
+	expected_width = func->card->host->ios.bus_width == MMC_BUS_WIDTH_4 ?
+		SDIO_BUS_WIDTH_4BIT : SDIO_BUS_WIDTH_1BIT;
+	if ((bus_interface & SDIO_BUS_WIDTH_MASK) != expected_width) {
+		atbm_printk_err("SDIO bus width mismatch: host=%u card_if=0x%02x; reinitializing communications\n",
+			func->card->host->ios.bus_width, bus_interface);
+		status = sdio_reset_comm(func->card);
+		atbm_printk_err("SDIO communications reinit: status=%d host_width=%u\n",
+			status, func->card->host->ios.bus_width);
+		if (status)
+			return status;
+	}
+#endif
 
 	atbm_dbg(ATBM_APOLLO_DBG_INIT, "Probe called\n");
 	#ifdef TIME_DEBUG
