@@ -21,6 +21,61 @@
 #ifdef LINUX_OS
 #define MAX_STATUS_LSIT_CNT  (10)
 
+#define BF01_HOST_MESSAGE_MAX 1600
+#define BF01_HOST_QUEUE_SIZE 16
+static DEFINE_SPINLOCK(bf01_host_lock);
+static DEFINE_MUTEX(bf01_host_reader);
+static char bf01_host_queue[BF01_HOST_QUEUE_SIZE][BF01_HOST_MESSAGE_MAX + 1];
+static unsigned int bf01_host_head;
+static unsigned int bf01_host_count;
+
+int atbm_bf01_host_indication(const u8 *data, size_t size)
+{
+	size_t length = strnlen((const char *)data, size);
+	unsigned int slot;
+
+	if (!length || length > BF01_HOST_MESSAGE_MAX || length == size)
+		return -EMSGSIZE;
+	spin_lock_bh(&bf01_host_lock);
+	if (bf01_host_count == BF01_HOST_QUEUE_SIZE) {
+		spin_unlock_bh(&bf01_host_lock);
+		return -ENOBUFS;
+	}
+	slot = (bf01_host_head + bf01_host_count) % BF01_HOST_QUEUE_SIZE;
+	memset(bf01_host_queue[slot], 0, BF01_HOST_MESSAGE_MAX + 1);
+	memcpy(bf01_host_queue[slot], data, length);
+	bf01_host_count++;
+	spin_unlock_bh(&bf01_host_lock);
+	return 0;
+}
+
+static int bf01_host_dequeue(unsigned long address)
+{
+	unsigned int slot;
+	int result;
+
+	if (mutex_lock_interruptible(&bf01_host_reader))
+		return -ERESTARTSYS;
+	spin_lock_bh(&bf01_host_lock);
+	if (!bf01_host_count) {
+		spin_unlock_bh(&bf01_host_lock);
+		mutex_unlock(&bf01_host_reader);
+		return -EAGAIN;
+	}
+	slot = bf01_host_head;
+	spin_unlock_bh(&bf01_host_lock);
+	result = copy_to_user((void __user *)address, bf01_host_queue[slot],
+		BF01_HOST_MESSAGE_MAX + 1) ? -EFAULT : 0;
+	if (!result) {
+		spin_lock_bh(&bf01_host_lock);
+		bf01_host_head = (bf01_host_head + 1) % BF01_HOST_QUEUE_SIZE;
+		bf01_host_count--;
+		spin_unlock_bh(&bf01_host_lock);
+	}
+	mutex_unlock(&bf01_host_reader);
+	return result;
+}
