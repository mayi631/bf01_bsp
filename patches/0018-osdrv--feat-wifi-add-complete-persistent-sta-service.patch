diff --git a/extdrv/wireless/realtek/atbm6461/tools/wifi.sh b/extdrv/wireless/realtek/atbm6461/tools/wifi.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e2ca1d8a22c2477711c5820816d2890d64706282
--- /dev/null
+++ b/extdrv/wireless/realtek/atbm6461/tools/wifi.sh
@@ -0,0 +1,243 @@
+#!/bin/sh
+
+umask 077
+WIFI_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
+CONTROL="$WIFI_DIR/atbm_wifi_ctl"
+RUN_DIR=/run/atbm_wifi
+CONFIG_DIR=/mnt/cfg/wifi
+NETWORK_FILE="$CONFIG_DIR/network.conf"
+PENDING_FILE=
+
+fail()
+{
+    echo "Wi-Fi: $*" >&2
+    exit 1
+}
+
+cleanup()
+{
+    if [ -n "$PENDING_FILE" ]; then
+        rm -f "$PENDING_FILE"
+    fi
+}
+
+configuration_ready()
+{
+    awk '$2 == "/mnt/cfg" { found = 1 } END { exit !found }' /proc/mounts ||
+        fail "/mnt/cfg is not mounted; refusing to save configuration on rootfs"
+    mkdir -p "$CONFIG_DIR" || fail "cannot create configuration directory"
+    chmod 700 "$CONFIG_DIR" || fail "cannot protect configuration directory"
+}
+
+watcher_running()
+{
+    [ -f "$RUN_DIR/watch.pid" ] || return 1
+    read -r WATCH_PID < "$RUN_DIR/watch.pid" || return 1
+    case "$WATCH_PID" in
+        ''|*[!0-9]*) return 1 ;;
+    esac
+    [ -r "/proc/$WATCH_PID/cmdline" ] || return 1
+    tr '\000' '\n' < "/proc/$WATCH_PID/cmdline" | grep -Fxq "$CONTROL" || return 1
+    kill -0 "$WATCH_PID" 2>/dev/null
+}
+
+prepare_resolver()
+{
+    if [ ! -f /run/resolv.conf ]; then
+        cp /etc/resolv.conf /run/resolv.conf || fail "cannot initialize DNS resolver"
+    fi
+    cp /run/resolv.conf "$RUN_DIR/resolv.before" || fail "cannot back up DNS resolver"
+    if [ ! -L /etc/resolv.conf ] &&
+       ! awk '$2 == "/etc/resolv.conf" { found = 1 } END { exit !found }' /proc/mounts; then
+        mount -o bind /run/resolv.conf /etc/resolv.conf || fail "cannot make DNS resolver writable"
+    fi
+}
+
+start_service()
+{
+    [ -x "$CONTROL" ] || fail "missing executable: $CONTROL"
+    if pidof atbm_iot_supplicant >/dev/null 2>&1; then
+        fail "atbm_iot_supplicant is running; stop it before using this service"
+    fi
+    if watcher_running; then
+        return 0
+    fi
+    if [ ! -d /sys/module/cfg80211 ]; then
+        insmod /mnt/system/ko/cfg80211.ko || fail "cannot load cfg80211"
+    fi
+    if [ ! -d /sys/module/atbm6461_wifi_sdio ]; then
+        insmod /mnt/system/ko/3rd/atbm6461_wifi_sdio.ko || fail "cannot load ATBM6461 driver"
+    fi
+    WAIT_COUNT=0
+    while [ ! -e /sys/class/net/wlan0 ] || [ ! -c /dev/atbm_ioctl ]; do
+        [ "$WAIT_COUNT" -lt 15 ] || fail "driver did not create wlan0 and /dev/atbm_ioctl"
+        sleep 1
+        WAIT_COUNT=$((WAIT_COUNT + 1))
+    done
+    ifconfig wlan0 up || fail "cannot open wlan0"
+    prepare_resolver
+    rm -f "$RUN_DIR/watcher.ready" "$RUN_DIR/network.ready" "$RUN_DIR/scan.done"
+    nohup "$CONTROL" watch </dev/null >"$RUN_DIR/wifi.log" 2>&1 9>&- &
+    WATCH_PID=$!
+    printf '%s\n' "$WATCH_PID" > "$RUN_DIR/watch.pid"
+    WAIT_COUNT=0
+    while [ ! -f "$RUN_DIR/watcher.ready" ]; do
+        kill -0 "$WATCH_PID" 2>/dev/null || fail "network watcher exited; inspect $RUN_DIR/wifi.log"
+        [ "$WAIT_COUNT" -lt 10 ] || fail "network watcher startup timed out"
+        sleep 1
+        WAIT_COUNT=$((WAIT_COUNT + 1))
+    done
+    echo "Wi-Fi service ready"
+}
+
+stop_service()
+{
+    if watcher_running; then
+        "$CONTROL" disconnect || echo "Wi-Fi: module disconnect failed; disabling Linux interface" >&2
+        kill -TERM "$WATCH_PID" || fail "cannot stop network watcher"
+        WAIT_COUNT=0
+        while kill -0 "$WATCH_PID" 2>/dev/null; do
+            [ "$WAIT_COUNT" -lt 15 ] || fail "network watcher stop timed out"
+            sleep 1
+            WAIT_COUNT=$((WAIT_COUNT + 1))
+        done
+    fi
+    if [ -e /sys/class/net/wlan0 ]; then
+        ifconfig wlan0 0.0.0.0 down || fail "cannot close wlan0"
+    fi
+    rm -f "$RUN_DIR/watch.pid" "$RUN_DIR/watcher.ready" "$RUN_DIR/network.ready"
+    echo "Wi-Fi disabled"
+}
+
+connect_saved()
+{
+    if [ -f "$NETWORK_FILE" ]; then
+        "$CONTROL" connect "$NETWORK_FILE" || return 1
+    else
+        echo "No saved network; use wifi scan, then wifi connect SSID PASSWORD"
+    fi
+}
+
+save_and_connect()
+{
+    [ "$#" -ge 1 ] && [ "$#" -le 3 ] || fail "usage: wifi connect SSID [PASSWORD] [WPA2|WPA|WPA3|NONE]"
+    NETWORK_SSID=$1
+    NETWORK_KEY=${2-}
+    if [ "$#" -ge 3 ]; then
+        NETWORK_SECURITY=$3
+    elif [ -n "$NETWORK_KEY" ]; then
+        NETWORK_SECURITY=WPA2
+    else
+        NETWORK_SECURITY=NONE
+    fi
+    NEWLINE='
+'
+    CARRIAGE_RETURN=$(printf '\r')
+    case "$NETWORK_SSID$NETWORK_KEY$NETWORK_SECURITY" in
+        *"$NEWLINE"*|*"$CARRIAGE_RETURN"*) fail "SSID, password and security must not contain CR or LF" ;;
+    esac
+    configuration_ready
+    PENDING_FILE=$(mktemp "$CONFIG_DIR/network.XXXXXX") || fail "cannot create private configuration"
+    printf '%s\n%s\n%s\n' "$NETWORK_SSID" "$NETWORK_KEY" "$NETWORK_SECURITY" > "$PENDING_FILE" ||
+        fail "cannot write network configuration"
+    start_service
+    "$CONTROL" connect "$PENDING_FILE" || fail "connection failed; previous saved network is unchanged"
+    mv -f "$PENDING_FILE" "$NETWORK_FILE" || fail "connected, but could not save network"
+    PENDING_FILE=
+    rm -f "$CONFIG_DIR/disabled"
+    sync
+    echo "Network saved; it will reconnect on boot or wifi on"
+}
+
+usage()
+{
+    echo 'Usage: wifi {on|off|scan|connect SSID [PASSWORD] [SECURITY]|disconnect|status|forget|boot|shutdown}'
+}
+
+[ "$#" -ge 1 ] || { usage; exit 1; }
+mkdir -p "$RUN_DIR" || fail "cannot create runtime directory"
+chmod 700 "$RUN_DIR" || fail "cannot protect runtime directory"
+exec 9>"$RUN_DIR/control.lock"
+LOCK_WAIT=0
+while ! flock -n 9; do
+    [ "$LOCK_WAIT" -lt 60 ] || fail "another Wi-Fi operation is still running"
+    sleep 1
+    LOCK_WAIT=$((LOCK_WAIT + 1))
+done
+trap cleanup EXIT
+trap 'exit 1' INT TERM
+
+ACTION=$1
+shift
+case "$ACTION" in
+    connect)
+        save_and_connect "$@"
+        ;;
+    on|start)
+        [ "$#" -eq 0 ] || fail "on takes no arguments"
+        configuration_ready
+        start_service
+        rm -f "$CONFIG_DIR/disabled"
+        sync
+        connect_saved || exit 1
+        ;;
+    boot)
+        [ "$#" -eq 0 ] || fail "boot takes no arguments"
+        configuration_ready
+        if [ -f "$CONFIG_DIR/disabled" ]; then
+            echo "Wi-Fi is saved as disabled"
+            exit 0
+        fi
+        start_service
+        connect_saved || exit 1
+        ;;
+    off|stop)
+        [ "$#" -eq 0 ] || fail "off takes no arguments"
+        configuration_ready
+        stop_service
+        : > "$CONFIG_DIR/disabled"
+        sync
+        ;;
+    shutdown)
+        [ "$#" -eq 0 ] || fail "shutdown takes no arguments"
+        stop_service
+        ;;
+    scan)
+        [ "$#" -eq 0 ] || fail "scan takes no arguments"
+        start_service
+        "$CONTROL" scan
+        ;;
+    disconnect)
+        [ "$#" -eq 0 ] || fail "disconnect takes no arguments"
+        watcher_running || fail "Wi-Fi is off"
+        "$CONTROL" disconnect
+        ;;
+    status)
+        [ "$#" -eq 0 ] || fail "status takes no arguments"
+        if watcher_running; then
+            echo 'wifi_enabled=1'
+            "$CONTROL" status || exit 1
+            ifconfig wlan0
+            route -n
+            cat /etc/resolv.conf
+        else
+            echo 'wifi_enabled=0'
+        fi
+        ;;
+    forget)
+        [ "$#" -eq 0 ] || fail "forget takes no arguments"
+        configuration_ready
+        WAS_RUNNING=0
+        if watcher_running; then WAS_RUNNING=1; fi
+        start_service
+        "$CONTROL" forget || exit 1
+        rm -f "$NETWORK_FILE"
+        if [ "$WAS_RUNNING" -eq 0 ]; then stop_service; fi
+        sync
+        echo 'Saved network removed'
+        ;;
+    *)
+        usage
+        exit 1
+        ;;
+esac
diff --git a/extdrv/wireless/realtek/atbm6461/tools/wifi_ctl.c b/extdrv/wireless/realtek/atbm6461/tools/wifi_ctl.c
new file mode 100644
index 0000000000000000000000000000000000000000..07b9c941f38210b01f241623153f28b1162be7f7
--- /dev/null
+++ b/extdrv/wireless/realtek/atbm6461/tools/wifi_ctl.c
@@ -0,0 +1,520 @@
+#define _POSIX_C_SOURCE 200809L
+#define _DEFAULT_SOURCE
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <net/if.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "atbm_tool.h"
+#include "atbm_ioctl_ext.h"
+
+#define RUN_DIR "/run/atbm_wifi"
+
+static volatile sig_atomic_t event_pending = 1;
+static volatile sig_atomic_t stopping;
+static struct HostConnectEvent applied_network;
+static int network_active;
+
+static void handle_signal(int signal_number)
+{
+	if (signal_number == SIGIO)
+		event_pending = 1;
+	else
+		stopping = 1;
+}
+
+static int run_program(char *const arguments[], int quiet)
+{
+	pid_t child_pid;
+	int child_status;
+	int null_fd;
+
+	child_pid = fork();
+	if (child_pid < 0)
+		return -1;
+	if (child_pid == 0) {
+		if (quiet) {
+			null_fd = open("/dev/null", O_WRONLY);
+			if (null_fd >= 0) {
+				dup2(null_fd, STDOUT_FILENO);
+				dup2(null_fd, STDERR_FILENO);
+				close(null_fd);
+			}
+		}
+		execvp(arguments[0], arguments);
+		_exit(127);
+	}
+	while (waitpid(child_pid, &child_status, 0) < 0) {
+		if (errno != EINTR)
+			return -1;
+	}
+	return WIFEXITED(child_status) && WEXITSTATUS(child_status) == 0 ? 0 : -1;
+}
+
+static int get_status(int device_fd, struct status_info *current_status)
+{
+	memset(current_status, 0, sizeof(*current_status));
+	return ioctl(device_fd, ATBM_STATUS, current_status);
+}
+
+static void address_text(u32 address_value, char *text)
+{
+	struct in_addr address;
+	address.s_addr = address_value;
+	inet_ntop(AF_INET, &address, text, INET_ADDRSTRLEN);
+}
+
+static int print_status(int device_fd)
+{
+	struct status_info current_status;
+	char address[INET_ADDRSTRLEN];
+
+	if (get_status(device_fd, &current_status) != 0)
+		return -1;
+	printf("wifi_mode=%s\nwpa_state=%s\n", current_status.wifimode ? "AP" : "STA",
+		current_status.bconnect || current_status.wifimode ? "ACTIVE" : "INACTIVE");
+	printf("mac_address=%02x:%02x:%02x:%02x:%02x:%02x\n",
+		current_status.macaddr[0], current_status.macaddr[1], current_status.macaddr[2],
+		current_status.macaddr[3], current_status.macaddr[4], current_status.macaddr[5]);
+	if (!current_status.bconnect && !current_status.wifimode)
+		return 0;
+	printf("ssid=%.*s\n", current_status.con_event.ssidlen > sizeof(current_status.con_event.ssid) ?
+		(int)sizeof(current_status.con_event.ssid) : current_status.con_event.ssidlen,
+		current_status.con_event.ssid);
+	address_text(current_status.con_event.ipaddr, address);
+	printf("ip_address=%s\n", address);
+	address_text(current_status.con_event.ipmask, address);
+	printf("netmask=%s\n", address);
+	address_text(current_status.con_event.gwaddr, address);
+	printf("gateway=%s\n", address);
+	address_text(current_status.con_event.dnsaddr[0], address);
+	printf("dns1=%s\n", address);
+	address_text(current_status.con_event.dnsaddr[1], address);
+	printf("dns2=%s\n", address);
+	return 0;
+}
+
+static int default_route_matches(u32 gateway)
+{
+	FILE *routes;
+	char line[256];
+	char interface_name[32];
+	unsigned long destination;
+	unsigned long route_gateway;
+	unsigned int flags;
+	int found = 0;
+
+	if (!gateway)
+		return 1;
+	routes = fopen("/proc/net/route", "r");
+	if (!routes)
+		return 0;
+	while (fgets(line, sizeof(line), routes)) {
+		if (sscanf(line, "%31s %lx %lx %x", interface_name, &destination, &route_gateway, &flags) == 4 &&
+			!strcmp(interface_name, "wlan0") && destination == 0 &&
+			route_gateway == gateway && (flags & 3) == 3) {
+			found = 1;
+			break;
+		}
+	}
+	fclose(routes);
+	return found;
+}
+
+static int linux_address_matches(const struct HostConnectEvent *event)
+{
+	struct ifreq interface_request;
+	int socket_fd = socket(AF_INET, SOCK_DGRAM, 0);
+	int matches = 0;
+
+	if (socket_fd < 0)
+		return 0;
+	memset(&interface_request, 0, sizeof(interface_request));
+	strcpy(interface_request.ifr_name, "wlan0");
+	if (ioctl(socket_fd, SIOCGIFADDR, &interface_request) == 0 &&
+		((struct sockaddr_in *)&interface_request.ifr_addr)->sin_addr.s_addr == event->ipaddr &&
+		ioctl(socket_fd, SIOCGIFNETMASK, &interface_request) == 0 &&
+		((struct sockaddr_in *)&interface_request.ifr_netmask)->sin_addr.s_addr == event->ipmask &&
+		ioctl(socket_fd, SIOCGIFFLAGS, &interface_request) == 0 &&
+		(interface_request.ifr_flags & IFF_UP))
+		matches = 1;
+	close(socket_fd);
+	return matches;
+}
+
+static void remove_default_routes(void)
+{
+	char *arguments[] = {"route", "del", "default", "dev", "wlan0", NULL};
+	int attempts;
+	for (attempts = 0; attempts < 8; attempts++) {
+		if (run_program(arguments, 1) != 0)
+			break;
+	}
+}
+
+static int copy_resolver(const char *source_path)
+{
+	FILE *source = fopen(source_path, "r");
+	FILE *destination;
+	char line[256];
+	int failed = 0;
+
+	if (!source)
+		return -1;
+	destination = fopen("/run/resolv.conf", "w");
+	if (!destination) {
+		fclose(source);
+		return -1;
+	}
+	while (fgets(line, sizeof(line), source)) {
+		if (fputs(line, destination) == EOF)
+			failed = 1;
+	}
+	if (ferror(source))
+		failed = 1;
+	fclose(source);
+	if (fclose(destination) != 0)
+		failed = 1;
+	return failed ? -1 : 0;
+}
+
+static int write_resolver(const struct HostConnectEvent *event)
+{
+	FILE *resolver;
+	char address[INET_ADDRSTRLEN];
+	int dns_index;
+	int dns_count = 0;
+	int failed = 0;
+
+	resolver = fopen("/run/resolv.conf", "w");
+	if (!resolver)
+		return -1;
+	for (dns_index = 0; dns_index < 2; dns_index++) {
+		if (!event->dnsaddr[dns_index])
+			continue;
+		address_text(event->dnsaddr[dns_index], address);
+		if (fprintf(resolver, "nameserver %s\n", address) < 0)
+			failed = 1;
+		dns_count++;
+	}
+	if (!dns_count && event->gwaddr) {
+		address_text(event->gwaddr, address);
+		if (fprintf(resolver, "nameserver %s\n", address) < 0)
+			failed = 1;
+	}
+	if (fclose(resolver) != 0)
+		failed = 1;
+	return failed ? -1 : 0;
+}
+
+static void clear_network(void)
+{
+	char *arguments[] = {"ifconfig", "wlan0", "0.0.0.0", NULL};
+	if (!network_active)
+		return;
+	remove_default_routes();
+	run_program(arguments, 1);
+	copy_resolver(RUN_DIR "/resolv.before");
+	unlink(RUN_DIR "/network.ready");
+	network_active = 0;
+	puts("Linux Wi-Fi address and route cleared");
+}
+
+static int sync_network(const struct status_info *current_status)
+{
+	const struct HostConnectEvent *event = &current_status->con_event;
+	char ip_address[INET_ADDRSTRLEN];
+	char netmask[INET_ADDRSTRLEN];
+	char gateway[INET_ADDRSTRLEN];
+	char *configure[] = {"ifconfig", "wlan0", ip_address, "netmask", netmask, "up", NULL};
+	char *route[] = {"route", "add", "default", "gw", gateway, "dev", "wlan0", "metric", "50", NULL};
+	FILE *ready;
+
+	if (!current_status->bconnect || current_status->wifimode) {
+		clear_network();
+		return 0;
+	}
+	if (!event->ipaddr || !event->ipmask)
+		return 0;
+	if (network_active && applied_network.ipaddr == event->ipaddr &&
+		applied_network.ipmask == event->ipmask && applied_network.gwaddr == event->gwaddr &&
+		memcmp(applied_network.dnsaddr, event->dnsaddr, sizeof(event->dnsaddr)) == 0 &&
+		linux_address_matches(event) && default_route_matches(event->gwaddr) &&
+		access(RUN_DIR "/network.ready", F_OK) == 0)
+		return 0;
+	address_text(event->ipaddr, ip_address);
+	address_text(event->ipmask, netmask);
+	address_text(event->gwaddr, gateway);
+	if (run_program(configure, 0) != 0)
+		return -1;
+	network_active = 1;
+	remove_default_routes();
+	if (event->gwaddr && run_program(route, 0) != 0)
+		return -1;
+	if (write_resolver(event) != 0)
+		return -1;
+	ready = fopen(RUN_DIR "/network.ready", "w");
+	if (!ready)
+		return -1;
+	fprintf(ready, "%s\n", ip_address);
+	if (fclose(ready) != 0)
+		return -1;
+	memcpy(&applied_network, event, sizeof(applied_network));
+	printf("Linux Wi-Fi ready: ip=%s netmask=%s gateway=%s\n", ip_address, netmask, gateway);
+	return 0;
+}
+
+static void drain_events(int device_fd)
+{
+	struct status_async event;
+	int attempts;
+	FILE *completed;
+
+	for (attempts = 0; attempts < 128 && !stopping; attempts++) {
+		if (read(device_fd, &event, sizeof(event)) != (ssize_t)sizeof(event))
+			break;
+		if (event.type == 2) {
+			completed = fopen(RUN_DIR "/scan.done", "w");
+			if (completed)
+				fclose(completed);
+		} else if (event.type == 4 || event.type == 5) {
+			printf("Wi-Fi event: type=%u reason=%u\n", event.type, event.driver_mode);
+		}
+		if (event.list_empty)
+			break;
+	}
+}
+
+static int watch_network(int device_fd)
+{
+	struct sigaction action;
+	struct status_info current_status;
+	struct timespec delay = {1, 0};
+	int lock_fd;
+	int flags;
+	FILE *ready;
+
+	lock_fd = open(RUN_DIR "/watch.lock", O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+	if (lock_fd < 0 || flock(lock_fd, LOCK_EX | LOCK_NB) != 0)
+		return -1;
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = handle_signal;
+	sigemptyset(&action.sa_mask);
+	sigaction(SIGIO, &action, NULL);
+	sigaction(SIGTERM, &action, NULL);
+	sigaction(SIGINT, &action, NULL);
+	flags = fcntl(device_fd, F_GETFL);
+	if (flags < 0 || fcntl(device_fd, F_SETOWN, getpid()) != 0 ||
+		fcntl(device_fd, F_SETFL, flags | FASYNC) != 0)
+		return -1;
+	event_pending = 0;
+	drain_events(device_fd);
+	ready = fopen(RUN_DIR "/watcher.ready", "w");
+	if (!ready)
+		return -1;
+	fprintf(ready, "%ld\n", (long)getpid());
+	fclose(ready);
+	while (!stopping) {
+		if (event_pending) {
+			event_pending = 0;
+			drain_events(device_fd);
+		}
+		if (get_status(device_fd, &current_status) == 0 && sync_network(&current_status) != 0)
+			perror("synchronize Linux Wi-Fi network");
+		nanosleep(&delay, NULL);
+	}
+	clear_network();
+	unlink(RUN_DIR "/watcher.ready");
+	close(lock_fd);
+	return 0;
+}
+
+static int scan_networks(int device_fd)
+{
+	struct scan_result results;
+	int wait_seconds;
+	int result_index;
+	int pages;
+
+	unlink(RUN_DIR "/scan.done");
+	if (ioctl(device_fd, ATBM_SCAN) != 0)
+		return -1;
+	for (wait_seconds = 0; wait_seconds < 15; wait_seconds++) {
+		if (access(RUN_DIR "/scan.done", F_OK) == 0)
+			break;
+		sleep(1);
+	}
+	if (wait_seconds == 15) {
+		fprintf(stderr, "Scan completion timed out\n");
+		return -1;
+	}
+	memset(&results, 0, sizeof(results));
+	results.remain = 1;
+	puts("BSSID\t\t\tRSSI\tCHANNEL\tSECURITY\tSSID");
+	for (pages = 0; results.remain && pages < 32; pages++) {
+		if (ioctl(device_fd, ATBM_SCAN_INFO, &results) != 0 || results.scan_cnt > SCAN_RESULT_MAX_CNT)
+			return -1;
+		for (result_index = 0; result_index < results.scan_cnt; result_index++) {
+			const struct scan_result_info *result = &results.scan_info[result_index];
+			printf("%02x:%02x:%02x:%02x:%02x:%02x\t%d\t%u\t%s\t\t%.*s\n",
+				result->bssid[0], result->bssid[1], result->bssid[2], result->bssid[3],
+				result->bssid[4], result->bssid[5], result->rssi, result->channel,
+				result->rsn ? "WPA2+" : result->wpa ? "WPA" : result->encrypt ? "WEP" : "OPEN",
+				result->ssidlen > 32 ? 32 : result->ssidlen, result->ssid);
+		}
+	}
+	return results.remain ? -1 : 0;
+}
+
+static int read_network(const char *path, struct connect_info *connection)
+{
+	FILE *configuration;
+	char ssid[128];
+	char key[128];
+	char security[32];
+	char *lines[] = {ssid, key, security};
+	size_t sizes[] = {sizeof(ssid), sizeof(key), sizeof(security)};
+	size_t line_index;
+	size_t key_index;
+
+	memset(connection, 0, sizeof(*connection));
+	configuration = fopen(path, "r");
+	if (!configuration)
+		return -1;
+	for (line_index = 0; line_index < 3; line_index++) {
+		if (!fgets(lines[line_index], sizes[line_index], configuration) ||
+			!strchr(lines[line_index], '\n')) {
+			fclose(configuration);
+			return -1;
+		}
+		lines[line_index][strcspn(lines[line_index], "\r\n")] = '\0';
+	}
+	fclose(configuration);
+	if (!strcmp(security, "NONE"))
+		connection->keyMgmt = KEY_MGMT_NONE;
+	else if (!strcmp(security, "WPA"))
+		connection->keyMgmt = KEY_MGMT_WPA;
+	else if (!strcmp(security, "WPA2"))
+		connection->keyMgmt = KEY_MGMT_WPA2;
+	else if (!strcmp(security, "WPA3"))
+		connection->keyMgmt = KEY_MGMT_WPA3;
+	else
+		return -1;
+	if (!strlen(ssid) || strlen(ssid) > sizeof(connection->ssid) || strlen(key) > sizeof(connection->key))
+		return -1;
+	if (connection->keyMgmt == KEY_MGMT_NONE && strlen(key))
+		return -1;
+	if (connection->keyMgmt != KEY_MGMT_NONE && (strlen(key) < 8 || strlen(key) > 64))
+		return -1;
+	if (strlen(key) == 64) {
+		if (connection->keyMgmt == KEY_MGMT_WPA3)
+			return -1;
+		for (key_index = 0; key_index < 64; key_index++) {
+			if (!strchr("0123456789abcdefABCDEF", key[key_index]))
+				return -1;
+		}
+	}
+	connection->ssidLength = strlen(ssid);
+	connection->keyLength = strlen(key);
+	memcpy(connection->ssid, ssid, connection->ssidLength);
+	memcpy(connection->key, key, connection->keyLength);
+	return 0;
+}
+
+static int connect_network(int device_fd, const char *configuration_path)
+{
+	struct connect_info connection;
+	struct status_info current_status;
+	struct auto_reconnect_req reconnect;
+	int wait_seconds;
+
+	if (read_network(configuration_path, &connection) != 0) {
+		fprintf(stderr, "Invalid network configuration: check SSID, password length and security\n");
+		return -1;
+	}
+	if (get_status(device_fd, &current_status) != 0)
+		return -1;
+	if (current_status.wifimode && ioctl(device_fd, ATBM_WIFI_MODE, 0UL) != 0)
+		return -1;
+	memset(&reconnect, 0, sizeof(reconnect));
+	reconnect.auto_enable = 1;
+	if (ioctl(device_fd, ATBM_AUTO_RECONN, &reconnect) != 0)
+		return -1;
+	if (ioctl(device_fd, ATBM_CONNECT, &connection) != 0)
+		return -1;
+	for (wait_seconds = 0; wait_seconds < 45; wait_seconds++) {
+		if (get_status(device_fd, &current_status) == 0 && current_status.bconnect &&
+			current_status.con_event.ssidlen == connection.ssidLength &&
+			memcmp(current_status.con_event.ssid, connection.ssid, connection.ssidLength) == 0 &&
+			current_status.con_event.ipaddr && current_status.con_event.ipmask &&
+			linux_address_matches(&current_status.con_event) &&
+			default_route_matches(current_status.con_event.gwaddr) &&
+			access(RUN_DIR "/network.ready", F_OK) == 0) {
+			puts("Connected; Linux IP, netmask, route and DNS configured");
+			return print_status(device_fd);
+		}
+		sleep(1);
+	}
+	fprintf(stderr, "Connection timed out; inspect status and Wi-Fi log\n");
+	print_status(device_fd);
+	return -1;
+}
+
+static int disconnect_network(int device_fd)
+{
+	struct auto_reconnect_req reconnect;
+	struct at_cmd_info command;
+	memset(&reconnect, 0, sizeof(reconnect));
+	memset(&command, 0, sizeof(command));
+	if (ioctl(device_fd, ATBM_AUTO_RECONN, &reconnect) != 0)
+		return -1;
+	strcpy((char *)command.cmd, "AT+WIFI_DISCONNECT");
+	return ioctl(device_fd, ATBM_FW_AT_CMD, &command);
+}
+
+int main(int argc, char *argv[])
+{
+	int device_fd;
+	int result = -1;
+
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	if (argc < 2) {
+        fprintf(stderr, "Usage: atbm_wifi_ctl {watch|status|scan|connect FILE|disconnect|forget}\n");
+		return 1;
+	}
+	device_fd = open("/dev/atbm_ioctl", O_RDWR | O_CLOEXEC);
+	if (device_fd < 0) {
+		perror("open /dev/atbm_ioctl");
+		return 1;
+	}
+	if (argc == 2 && !strcmp(argv[1], "watch"))
+		result = watch_network(device_fd);
+	else if (argc == 2 && !strcmp(argv[1], "status"))
+		result = print_status(device_fd);
+	else if (argc == 2 && !strcmp(argv[1], "scan"))
+		result = scan_networks(device_fd);
+	else if (argc == 3 && !strcmp(argv[1], "connect"))
+		result = connect_network(device_fd, argv[2]);
+	else if (argc == 2 && !strcmp(argv[1], "disconnect"))
+		result = disconnect_network(device_fd);
+	else if (argc == 2 && !strcmp(argv[1], "forget")) {
+		result = disconnect_network(device_fd);
+		if (result == 0)
+			result = ioctl(device_fd, ATBM_CLEAR_WIFI_CFG);
+	}
+	else
+		fprintf(stderr, "Unknown command or wrong argument count\n");
+	close(device_fd);
+	return result == 0 ? 0 : 1;
+}
