From 27324c0f3d478ac1f861ef57624c69d6ed1440da Mon Sep 17 00:00:00 2001
From: mayi <3363523343@qq.com>
Date: Wed, 21 Oct 2026 18:34:08 +0800
Subject: [PATCH] feat(build): add BF01 ATBM6461 driver selection

Expose a board-scoped ATBM6461 option and retain external wireless modules in shrink-flash images. This patch only adds the build configuration switch.
---
 Kconfig | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/Kconfig b/Kconfig
index c48b1206b3093a6cd13a4bdad623b83633d272c6..4f9465a64757a22d71282d60b367a7ddebb140b9 100644
--- a/Kconfig
+++ b/Kconfig
@@ -295,6 +295,15 @@ config CP_EXT_WIRELESS
       Install the osdrv/extdrv/wireless/*.ko no matter
 	  FLASH_SIZE_SHRINK is set or not.
 
+config ATBM6461_BF01
+	bool "Build ATBM6461 IoT SDIO driver and tools for BF01"
+	depends on BOARD_bf01_spinand
+	select CP_EXT_WIRELESS if FLASH_SIZE_SHRINK
+	default n
+	help
+	  Build the external ATBM6461 FullMAC SDIO module and vendor tools.
+	  BF01 keeps the module powered and uses SDIO in-band interrupts.
+
 config NO_FB
 	bool "Do not compile frame buffer drivers"
 	depends on FLASH_SIZE_SHRINK
