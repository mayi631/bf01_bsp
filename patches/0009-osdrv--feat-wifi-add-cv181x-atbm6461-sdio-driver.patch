+		}else{		
+	
+		}
+	
+		//oob_irq = sunxi_wlan_get_oob_irq();
+	}
+	#endif
+#if (ATBM_WIFI_PLATFORM == 10)
+     mdelay(100);
+     rockchip_wifi_set_carddetect(enabled);
+#endif
+#endif
+	 atbm_printk_platform("[%s]:platform insert ctrl [%d]\n",platform,enabled);
+	return ret;
+}
