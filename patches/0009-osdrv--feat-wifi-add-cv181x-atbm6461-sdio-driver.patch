+SDIO_BUS       ?= $(CONFIG_ATBM_SDIO_BUS)
+SPI_BUS        ?= $(CONFIG_ATBM_SPI_BUS)
+CHECKSUM       ?= $(CONFIG_ATBM_FUNC_HW_CHSUM)
