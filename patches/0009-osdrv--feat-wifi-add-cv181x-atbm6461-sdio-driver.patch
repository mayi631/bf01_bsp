+	/* Check for PRE-FETCH bit to be cleared */
+	for (i = 0; i < 20; i++) {
+		ret = __atbm_reg_read_32(hw_priv, ATBM_HIFREG_CONFIG_REG_ID,
+					   &val32);
+		if (ret < 0) {
+			atbm_dbg(ATBM_APOLLO_DBG_ERROR,
+					"%s: Can't check prefetch bit.\n",
+					__func__);
+			mdelay(i);
+			continue;
+		}
+		if (!(val32 & prefetch))
+			break;
+
+		mdelay(i);
+	}
+
+	if (val32 & prefetch) {
