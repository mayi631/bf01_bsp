+		}
+		ret = atbm_ioctl_notify_add(0, 1, 0, event, NULL);
+	}
+	else
+	{
+		ret = atbm_ioctl_notify_add(0, 0, 0, NULL, NULL);
+	}
+
+	if (ret > 0)
+	{
+		kill_fasync (&connect_async, SIGIO, POLL_IN);
