+#define ATBM_HWBUF_EXTERN_HEADROM_LEN 	(64)  
+#define ATBM_HWBUF_EXTERN_TAILROM_LEN 	(64)  
+
+int atbm_skb_cnt = 0;
+int atbm_skb_free = 0;
+
+int lwip_queue_enable = 0;
+int lwip_enable = 0;
+
