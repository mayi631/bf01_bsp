+static inline u8 ieee80211_rssi_weight(s8 signal)
+{
+	u8 weight = 0;
+
+	if(signal <= -75)
+		weight = 0;
+	else if((signal>-75)&&(signal<= -65))
+		weight = 1;
+	else if((signal>-65)&&(signal<= -50))
+		weight = 2;
+	else if(signal > -50)
+		weight = 4;
+	else 
+		weight = 0;
+
+	return weight;
+}
