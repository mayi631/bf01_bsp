+endif
+ifeq ($(CONFIG_MAC80211_ATBM_RC_MINSTREL_HT),)
+ATBM_WIFI__EXT_CCFLAGS += -DCONFIG_MAC80211_ATBM_RC_MINSTREL_HT=1
+CONFIG_MAC80211_ATBM_RC_MINSTREL_HT=y
