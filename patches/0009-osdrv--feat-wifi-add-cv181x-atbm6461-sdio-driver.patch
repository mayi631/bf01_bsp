+CONFIG_RHEA    ?= $(CONFIG_ATBM6461)
+CONFIG_EROS    ?= $(CONFIG_ATBM6463)
+CONFIG_NOT_SUPPORT_40M_CHW ?= $(CONFIG_ATBM601x)
