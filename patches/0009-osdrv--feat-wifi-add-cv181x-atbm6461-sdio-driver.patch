+#ifndef STA_INFO_H
+#define STA_INFO_H
+
+#ifdef LINUX_OS
+#include <linux/list.h>
+#include <linux/types.h>
+#include <linux/if_ether.h>
+#include <linux/workqueue.h>
+#include <linux/average.h>
