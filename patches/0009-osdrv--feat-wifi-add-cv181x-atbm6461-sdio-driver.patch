+void atbm_customer_private_event(struct atbm_common *hw_priv, u8 *event_buffer)
+{
+	u32 private_event_id = *((u32*)event_buffer);
+
+	if (private_event_id == 0x64610929)
+	{
+		//crypto exp start
+		atbm_printk_init("start crypto exp config\n");
+		int ret = 0;
+
+		memset(&crypto_exp_req, 0, sizeof(crypto_exp_req));
+		crypto_exp_req.result_step = 0x1111;
+		ret = wsm_crypto_exp_config(hw_priv, &crypto_exp_req, sizeof(crypto_exp_req));
+		if (ret)
+		{
+			atbm_printk_err("%s: wsm_crypto_exp_config 1111 err.\n", __func__);
+			return;
+		}
+		if (crypto_exp_req.result_step == 0x2222)
+		{
+			//crypto exp process
+			atbm_printk_init("start crypto exp process\n");
+			ret = crypto_mod_exp(crypto_exp_req.base, crypto_exp_req.base_len, crypto_exp_req.power, crypto_exp_req.power_len, 
+				crypto_exp_req.modulus, crypto_exp_req.modulus_len, crypto_exp_req.result, crypto_exp_req.result_len);
+			if (ret)
+			{
+				crypto_exp_req.result_step = 0x2233;
+			}
+			else
+			{
+				crypto_exp_req.result_step = 0x3333;
+			}
+			ret = wsm_crypto_exp_config(hw_priv, &crypto_exp_req, sizeof(crypto_exp_req));
+			if (ret)
+			{
+				atbm_printk_err("%s: wsm_crypto_exp_config 223333 err.\n", __func__);
+				return;
+			}
+		}
