+
+				printf("Line:%d invalid channel %s\n", __LINE__, argv[1]);
+				printf("Line:%d no channel values configured.\n", __LINE__);
+				goto err;
+			}
+			etf_cfg_set.channel = value;
+		}
+		else if (!strcmp(argv[0], "rate"))
+		{
+#if (PROJ_TYPE!=HERA)
+			if (((etf_cfg_set.mode==0) && (value < 0 || value > 3))
+				|| ((etf_cfg_set.mode==1 || etf_cfg_set.mode==2) && (value < 0 || value > 7))
+				|| ((etf_cfg_set.mode==3) && (value < 0 || value > 11))
