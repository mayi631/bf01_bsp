+	if (vif->hw_priv->wsm_caps.firmwareCap&CAPABLITIES_HOST_BA_PARAM){
+		printk("clear ba params.\n");
+		atbm_reorder_func_reset(vif,0xff);
+	}
+
+exit:
+	return ;
+}
