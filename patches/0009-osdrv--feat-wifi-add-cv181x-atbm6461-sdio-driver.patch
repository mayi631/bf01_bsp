+char ConvertHexChar(char ch)
+{
+	if(ch >= '0' && ch <= '9')
+		return ch - '0';
+	if(ch >= 'a' && ch <= 'f')
+		return ch - 'a' + 10;
+	if(ch >= 'A' && ch < 'F')
+		return ch - 'A' + 10;
+	return -1;
+}
+
+static int str2mac(char *macstr, char *mac_save)
+{
+	char i = 0;
+	char tmp = 0;
+
+	for (i=0; i<5; i++)
+	{
+		tmp = ConvertHexChar(*macstr++);
+		if (tmp < 0)
+		{
+			return -1;
+		}
+		mac_save[i] = tmp*16;
+		tmp = ConvertHexChar(*macstr++);
+		if (tmp < 0)
+		{
+			return -1;
+		}
+		mac_save[i] += tmp;
+		macstr++;
+	}
+	tmp = ConvertHexChar(*macstr++);
+	if (tmp < 0)
+	{
+		return -1;
+	}
+	mac_save[5] = tmp*16;
+	tmp = ConvertHexChar(*macstr);
+	if (tmp < 0)
+	{
+		return -1;
+	}
+	mac_save[5] += tmp;
+	return 0;
+}
