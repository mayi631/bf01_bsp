+	@echo "driver version"
+	@cat hal_apollo/svn_version.h | awk '{print $3}'
+	@echo "**************************************"
+modules:clean
+	@echo "arch=$(ARCH)"						
+	$(MAKE) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) -C $(KDIR) M=$(shell pwd)  modules -j8
+#	$(MAKE) -C $(KDIR) M=$(PWD) modules
+
+tools_install:
