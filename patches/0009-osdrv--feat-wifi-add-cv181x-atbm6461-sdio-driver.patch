+void atbm_set_hostconfig(struct atbm_common *hw_priv)
+{
+	hw_priv->host_req.MsgStatus = 0;
+	hw_priv->host_req.MsgFlags[0] = MSG_F0_EVENT_TXCFM_CANCEL;
+	if(hw_priv->wsm_caps.firmwareCap&CAPABLITIES_HOST_BA_PARAM){
+		hw_priv->host_req.MsgFlags[1] = MSG_F1_HOST_BA_PARAM_SYNC;
+	}
+	else{
+		hw_priv->host_req.MsgFlags[1] = 0;
+	}
+	hw_priv->host_req.MsgFlags[1] |= MSG_F1_HOST_AP_LINKID_SYNC;
+	hw_priv->host_req.MsgFlags[2] = 0;
+	hw_priv->host_req.MsgFlags[3] = 0;
+	wsm_set_config(hw_priv,&hw_priv->host_req,sizeof(hw_priv->host_req));
+}
+
+void atbm_set_hostconfig_sync(struct atbm_common *hw_priv)
+{
+	int i = 0;
+	struct atbm_reorder_queue_comm * atbm_reorder = NULL;
+	struct atbm_ba_tid_params *tid_params;
+	struct atbm_vif *priv =__ABwifi_hwpriv_to_vifpriv(hw_priv,0);
+	if (priv && (priv->type==NL80211_IFTYPE_STATION)){
+		if(hw_priv->wsm_caps.firmwareCap&CAPABLITIES_HOST_BA_PARAM){
+			hw_priv->host_req.MsgStatus = 0;
+			hw_priv->host_req.MsgFlags[0] = 0;
+			hw_priv->host_req.MsgFlags[1] = MSG_F1_HOST_BA_PARAM_SYNC_REVERSE;
+			hw_priv->host_req.MsgFlags[2] = 0;
+			hw_priv->host_req.MsgFlags[3] = 0;
+			atbm_reorder = &priv->atbm_reorder_link_id[0];
+			for (i=0; i<ATBM_RX_DATA_QUEUES; i++){
+				tid_params = &atbm_reorder->atbm_rx_tid[i];
+				hw_priv->host_req.BASsn[i] = tid_params->start_seq;
+			}
+			wsm_set_config(hw_priv,&hw_priv->host_req,sizeof(hw_priv->host_req));
+		}
+	}
+}
