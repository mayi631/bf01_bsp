+		atbm_dbg(ATBM_APOLLO_DBG_ERROR,
+			"%s: set_wakeup: can't write " \
+			"control register.\n", __func__);
+		goto out;
+	}
+
+	/* Wait for wakeup */
+	for (i = 0 ; i < 3000 ; i += 1 + i / 2) {
+		ret = atbm_reg_read_16(hw_priv,
+			ATBM_HIFREG_CONTROL_REG_ID, &val16);
+		if (ret < 0) {
+			atbm_dbg(ATBM_APOLLO_DBG_ERROR,
+				"%s: wait_for_wakeup: can't read " \
