+    if(!__wifi_init_check()) {
+        drv_printk(C2, M_DRVSYS, " wifi has not inited \r\n");
+        return 0;
+    }
+
+	atbm_wifi_hw_deinit(); 
+	drv_printk(C3, M_DRVSYS, "[%s]-line:%d wifi deinit done!\n",__FUNCTION__, __LINE__);
+    wifi_init_state = 0;
+	return ret;
+}
