+#if ATBM_SW_SECURE_BOOT_SUPPORT
+#define SMU_REG_BASE 0x16101000
+#define SMU_REG_BASE_BIT_CPU_RESET_AOPD	BIT(8)
+
+int atbm_before_load_bootcode(struct atbm_common *hw_priv)
+{
+	int ret = 0;
+	u32 u32_reg_val = 0;
+
+	// Hold CPU
+	ret = atbm_ahb_read_32(hw_priv, SMU_REG_BASE, &u32_reg_val);
+	if (ret < 0) {
+		atbm_printk_err("read SMU_REG_BASE err\n");
+	}
+
+	u32_reg_val |= SMU_REG_BASE_BIT_CPU_RESET_AOPD;
+
+	ret = atbm_ahb_write_32(hw_priv, SMU_REG_BASE, u32_reg_val);
+	if (ret < 0) {
+		atbm_printk_err("write SMU_REG_BASE err\n");
+	}
+
+	return ret;				
+}
+
+#define SMU_REG_BOOT_CONFIG	(SMU_REG_BASE + 0x2C)
+#define SMU_REG_BOOT_CONFIG_BIT_BOOT_RST_ENABLE	BIT(0)
+#define SMU_REG_BOOT_CONFIG_BIT_ILM_BOOT_CONFIG	BIT(1)
+
+int atbm_after_load_bootcode(struct atbm_common *hw_priv)
+{
+	int ret;
+	u32 u32_reg_val;
+
+	ret = atbm_ahb_read_32(hw_priv, SMU_REG_BOOT_CONFIG, &u32_reg_val);
+	if (ret < 0) {
+		atbm_dbg(ATBM_APOLLO_DBG_ERROR,
+			"%s: SMU_REG_BOOT_CONFIG: can't read register.\n", __func__);
+		return ret;
+	}
+
+	// Boot Reset Enable
+	u32_reg_val |= SMU_REG_BOOT_CONFIG_BIT_BOOT_RST_ENABLE;
+	// ILM Boot Config
+	u32_reg_val |= SMU_REG_BOOT_CONFIG_BIT_ILM_BOOT_CONFIG;
+	// Clear IVB Address
+	u32_reg_val &= (0x0000FFFF);
+	// Boot Code Run from SRAM
+	u32_reg_val |= BOOTCODE_DOWNLOAD_SRAM_ADDR;
+
+	ret = atbm_ahb_write_32(hw_priv, SMU_REG_BOOT_CONFIG, u32_reg_val);
+	if(ret<0){
+		atbm_dbg(ATBM_APOLLO_DBG_ERROR,
+			"%s: SMU_REG_BOOT_CONFIG: can't write register.\n", __func__);
+		return ret;
+	}
+
+	// Release CPU
+	ret = atbm_ahb_read_32(hw_priv, SMU_REG_BASE, &u32_reg_val);
+	if (ret < 0) {
+		atbm_printk_err("read SMU_REG_BASE err\n");
+		return ret;
+	}
+
+	u32_reg_val &= ~SMU_REG_BASE_BIT_CPU_RESET_AOPD;
+
+	ret = atbm_ahb_write_32(hw_priv, SMU_REG_BASE, u32_reg_val);
+	if (ret < 0) {
+		atbm_printk_err("write SMU_REG_BASE err\n");
+	}
+
+	return ret;
+}
