+	if(ret<0)
+		atbm_printk_err("write 0xacc0178 err\n");
+#endif
+retry:
+	/* Read CONFIG Register Value - We will read 32 bits */
+	ret = atbm_reg_read_32(hw_priv, ATBM_HIFREG_CONFIG_REG_ID, &val32);
+	if (ret < 0) {
+		atbm_dbg(ATBM_APOLLO_DBG_ERROR,
