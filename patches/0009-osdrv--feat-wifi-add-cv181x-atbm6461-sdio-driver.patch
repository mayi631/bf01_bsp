+/*
+static void atbm_hw_buff_reset(struct atbm_common *hw_priv)
+{
+	hw_priv->wsm_tx_seq = 0;
+	hw_priv->buf_id_tx = 0;
+	hw_priv->wsm_rx_seq = 0;
