+USB_BUS=n
+SPI_BUS=n
+SDIO_BUS=y
+TX_NO_CONFIRM=y
+MULT_NAME=n
+ATBM_MAKEFILE_SUB=y
+
+LOAD_FW_H=n
+SKB_DEBUG=n
+MEM_DEBUG=n
+BRIDGE=n
+MONITOR=n
+EARLYSUSPEND=n
+CH5G=n
+USBAGGTX=n
+NOTXCONFIRM=y
