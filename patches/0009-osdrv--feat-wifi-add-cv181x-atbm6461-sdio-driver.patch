+
+
+NOSTDINC_FLAGS := -I$(src)/include/ \
+	-include $(src)/include/linux/compat-2.6.h \
+	-DCOMPAT_STATIC
+#####################################################
+export
+MODULES_NAME = atbm_wifi
+CONFIG_FPGA=n
+CONFIG_1601=n
+CONFIG_1606=n
+CONFIG_APOLLOC=n
+CONFIG_APOLLOD=n
+CONFIG_APOLLOE=n
+CONFIG_ATHENAA=n
+CONFIG_ATHENAB=n
+CONFIG_ATHENAB_24M=n
+CONFIG_ATHENAC=n
+CONFIG_ATHENALITE=n
+CONFIG_ATHENALITE_ECO=n
+CONFIG_ARES=n
+CONFIG_ARESB=n
