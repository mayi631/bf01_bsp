+#define MBEDTLS_BIGNUM_C
+#define NO_FLASH_FUNC
+#define FLASH_FUNC
+
+#if defined(MBEDTLS_BIGNUM_C)
+
+#include <linux/types.h>
+#include "bignum.h"
+#include "bn_mul.h"
