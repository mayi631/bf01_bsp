From c76a04c4827810a0c86c49ed44dea46722634a72 Mon Sep 17 00:00:00 2001
From: mayi <3363523343@qq.com>
Date: Wed, 21 Oct 2026 18:34:14 +0800
Subject: [PATCH] feat(osdrv/atbm6461): log first SDIO transfer failure and
 CCCR state

Capture the first CMD52/CMD53 failure with function, address, length, host timing and CCCR enable/ready/interface values. Log only once per device to avoid flooding retries.
---
 .../realtek/atbm6461/hal_apollo/apollo_sdio.c | 51 ++++++++++++++++++-
 1 file changed, 49 insertions(+), 2 deletions(-)

diff --git a/extdrv/wireless/realtek/atbm6461/hal_apollo/apollo_sdio.c b/extdrv/wireless/realtek/atbm6461/hal_apollo/apollo_sdio.c
index a63c22d1f20f0a0d810c9a54b76d675d683bed72..88561c65c79372b0d3529ad777a2f4cf14e674c0 100644
--- a/extdrv/wireless/realtek/atbm6461/hal_apollo/apollo_sdio.c
+++ b/extdrv/wireless/realtek/atbm6461/hal_apollo/apollo_sdio.c
@@ -111,6 +111,9 @@ struct atbm_sdio_thread
 struct sbus_priv {
 	struct sdio_func	*func;
 	struct atbm_common	*core;
+#ifdef LINUX_OS
+	unsigned long io_error_logged;
+#endif
 	struct atbm_sdio_thread tx_thread;
 	struct atbm_sdio_thread rx_thread;
 #ifndef LINUX_OS
@@ -697,24 +700,63 @@ static int atbm_sdio_rev_giveback(struct sbus_priv *self,void *giveback)
 #endif
 /* sbus_ops implemetation */
 
+#ifdef LINUX_OS
+static void atbm_sdio_log_io_error(struct sbus_priv *self,
+				 const char *operation, unsigned int addr,
+				 int count, int status)
+{
+	struct mmc_host *host = self->func->card->host;
+	unsigned char io_enable, io_ready, bus_interface;
+	int enable_status, ready_status, interface_status;
+
+	if (test_and_set_bit(0, &self->io_error_logged))
+		return;
+
+	atbm_printk_err("SDIO first failure: %s fn=%u addr=0x%x len=%d err=%d clock=%u width=%u timing=%u blksz=%u\n",
+		operation, self->func->num, addr, count, status,
+		host->ios.clock, host->ios.bus_width, host->ios.timing,
+		self->func->cur_blksize);
+	io_enable = sdio_f0_readb(self->func, SDIO_CCCR_IOEx, &enable_status);
+	io_ready = sdio_f0_readb(self->func, SDIO_CCCR_IORx, &ready_status);
+	bus_interface = sdio_f0_readb(self->func, SDIO_CCCR_IF, &interface_status);
+	atbm_printk_err("SDIO CMD52 state: IOEx=0x%02x err=%d IORx=0x%02x err=%d IF=0x%02x err=%d\n",
+		io_enable, enable_status, io_ready, ready_status,
+		bus_interface, interface_status);
+}
+#endif
+
 static int atbm_sdio_memcpy_fromio(struct sbus_priv *self,
 				     unsigned int addr,
 				     void *dst, int count)
 {
+	int ret;
+
 	if(is_pre_rmmod && (self->core->wsm_caps.firmwareVersion>=13549)){
 		return -1;
 	}
-	return sdio_memcpy_fromio(self->func, dst, addr, count);
+	ret = sdio_memcpy_fromio(self->func, dst, addr, count);
+#ifdef LINUX_OS
+	if (ret < 0)
+		atbm_sdio_log_io_error(self, "CMD53 read", addr, count, ret);
+#endif
+	return ret;
 }
 
 static int atbm_sdio_memcpy_toio(struct sbus_priv *self,
 				   unsigned int addr,
 				   const void *src, int count)
 {
+	int ret;
+
 	if(is_pre_rmmod && (self->core->wsm_caps.firmwareVersion>=13549)){
 		return -1;
 	}
-	return sdio_memcpy_toio(self->func, addr, (void *)src, count);
+	ret = sdio_memcpy_toio(self->func, addr, (void *)src, count);
+#ifdef LINUX_OS
+	if (ret < 0)
+		atbm_sdio_log_io_error(self, "CMD53 write", addr, count, ret);
+#endif
+	return ret;
 }
 
 int atbm_sdio_memcpy_fromio_for_sleep(struct sbus_priv *self,
@@ -1315,6 +1357,11 @@ static int atbm_sdio_probe(struct sdio_func *func,
 	atbm_sdio_set_drvdata(func, self);
 	sdio_claim_host(func);
 	status = atbm_sdio_enable_func(func);
+#ifdef LINUX_OS
+	if (status)
+		atbm_sdio_log_io_error(self, "enable_func CMD52",
+				       SDIO_CCCR_IOEx, 1, status);
+#endif
 	sdio_release_host(func);
 	if (status) {
 		atbm_printk_err("%s: enable function failed: %d\n", __func__, status);
