+++ b/tools/common/update_misc/Makefile
@@ -0,0 +1,45 @@
+SHELL = /bin/bash
+
+# Static Linux tool that reads/writes the A/B metadata in the misc partition.
+# Built by build/Makefile (rootfs-prepare) when CONFIG_AB_SYSTEM=y.
+
+ifeq ($(SDK_VER), 32bit)
+  export CROSS_COMPILE = $(CROSS_COMPILE_32)
+  OPT_LEVEL := -Os
+else ifeq ($(SDK_VER), 64bit)
+  export CROSS_COMPILE = $(CROSS_COMPILE_64)
+  OPT_LEVEL := -Os
+else ifeq ($(SDK_VER), uclibc)
+  export CROSS_COMPILE = $(CROSS_COMPILE_UCLIBC)
+  OPT_LEVEL := -Os
+else ifeq ($(SDK_VER), glibc_riscv64)
+  export CROSS_COMPILE = $(CROSS_COMPILE_GLIBC_RISCV64)
+  OPT_LEVEL := -Os -mcpu=c906fdv -march=rv64imafdcv0p7xthead -mcmodel=medany -mabi=lp64d
+else ifeq ($(SDK_VER), musl_riscv64)
+  export CROSS_COMPILE = $(CROSS_COMPILE_MUSL_RISCV64)
+  OPT_LEVEL := -Os -mcpu=c906fdv -march=rv64imafdcv0p7xthead -mcmodel=medany -mabi=lp64d
+endif
+
+CC = $(CROSS_COMPILE)gcc
+STRIP = $(CROSS_COMPILE)strip
+
+CFLAGS = $(OPT_LEVEL) -std=gnu11 -Wall -Wextra -Werror
+ifeq ($(AB_DEFAULT_SLOT_B), y)
+CFLAGS += -DAB_DEFAULT_SLOT=1
+else
+CFLAGS += -DAB_DEFAULT_SLOT=0
+endif
+LDFLAGS = -static
+
+SRCS = update_misc.c
+TARGET = update_misc
+
+.PHONY: all clean
+all: $(TARGET)
+
+$(TARGET): $(SRCS) update_misc.h
+	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LDFLAGS)
+	$(STRIP) $@
+
+clean:
+	rm -f $(TARGET) *.o
diff --git a/tools/common/update_misc/gen_abmisc.py b/tools/common/update_misc/gen_abmisc.py
new file mode 100755
index 0000000000000000000000000000000000000000..33a7436187a22d64418e22b97ddcd5e7d6a5f3cf
--- /dev/null
+++ b/tools/common/update_misc/gen_abmisc.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Generate the raw misc.spinand image holding the A/B metadata (AvbABData).
+
+usage: gen_abmisc.py <partition.xml> <output> <nand_block_size> [--default-slot a|b]
+
+The image is one erase block (or the partition size if smaller) filled with
+0xFF and the 32-byte AvbABData record at offset 0. Layout must match
+u-boot include/cvi_boot_mode.h and update_misc.h.
+"""
+import argparse
+import struct
+import sys
+import xml.etree.ElementTree as ET
+import zlib
+
+MAGIC = b"\0AB0"
+MAX_PRIORITY = 15
+MAX_TRIES = 3
+
+
+def ab_data(active):
+    prio_a = MAX_PRIORITY if active == "a" else MAX_PRIORITY - 1
+    prio_b = MAX_PRIORITY if active == "b" else MAX_PRIORITY - 1
+    body = MAGIC + struct.pack("<BBxx", 1, 0)
+    body += struct.pack("<BBBx", prio_a, MAX_TRIES, 0)
+    body += struct.pack("<BBBx", prio_b, MAX_TRIES, 0)
+    body += b"\0" * 12
+    assert len(body) == 28
+    return body + struct.pack("<I", zlib.crc32(body) & 0xFFFFFFFF)
+
+
+def misc_part_size(xml_path):
+    root = ET.parse(xml_path).getroot()
+    for p in root:
+        if p.attrib.get("label") != "misc":
+            continue
+        if "size_in_kb" in p.attrib:
+            return int(p.attrib["size_in_kb"]) * 1024
+        return int(p.attrib["size_in_b"])
+    raise SystemExit("misc partition not found in %s" % xml_path)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("xml")
+    ap.add_argument("output")
+    ap.add_argument("block_size", type=int)
+    ap.add_argument("--default-slot", choices=["a", "b"], default="a")
+    args = ap.parse_args()
+
+    size = min(misc_part_size(args.xml), args.block_size)
+    image = bytearray(b"\xff" * size)
+    data = ab_data(args.default_slot)
+    image[: len(data)] = data
+    with open(args.output, "wb") as f:
+        f.write(image)
+    print("misc image %s: %d bytes, active slot %s" % (args.output, size, args.default_slot))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/common/update_misc/update_misc.c b/tools/common/update_misc/update_misc.c
new file mode 100644
index 0000000000000000000000000000000000000000..65c15dca2720aa8aa2f2f2096e111ac117ff0412
--- /dev/null
+++ b/tools/common/update_misc/update_misc.c
@@ -0,0 +1,446 @@
+/*
+ * update_misc - control A/B boot through the misc partition (SPI NAND).
+ *
+ * The misc partition holds one AvbABData record at offset 0 of its first
+ * good erase block (the rest of the block is 0xFF). u-boot SPL picks the
+ * bootable slot with the highest priority and decrements tries_remaining;
+ * Linux calls "update_misc spinand boot_ok" after a successful boot to refill
+ * the tries of the running slot, and "set_active a|b" to switch slots.
+ *
+ * Usage: update_misc [spinand] [boot_ok|dump|get_active|set_active a|b [N]|
+ *                                set_tries a|b N|reinit]
+ *        (no command = boot_ok, compatible with the y15 tool)
+ * The retry count N (1..255) is stored per slot in AvbABData.reserved2[0/1]
+ * so that boot_ok refills tries_remaining to the configured value.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <sys/ioctl.h>
+#include <mtd/mtd-user.h>
+
+#include "update_misc.h"
+
+#define MISC_MTD_NAME "misc"
+
+enum slot_id { SLOT_A = 0, SLOT_B = 1, SLOT_UNKNOWN = -1 };
+
+static uint32_t crc32_zlib(const uint8_t *buf, size_t size)
+{
+	uint32_t crc = 0xFFFFFFFFu;
+	size_t i;
+	int bit;
+
+	for (i = 0; i < size; i++) {
+		crc ^= buf[i];
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+	}
+	return crc ^ 0xFFFFFFFFu;
+}
+
+static uint32_t ab_crc(const AvbABData *d)
+{
+	return crc32_zlib((const uint8_t *)d, sizeof(*d) - sizeof(d->crc32));
+}
+
+static bool ab_valid(const AvbABData *d)
+{
+	return memcmp(d->magic, AVB_AB_MAGIC, AVB_AB_MAGIC_LEN) == 0 &&
+	       ab_crc(d) == d->crc32;
+}
+
+static void ab_defaults(AvbABData *d, int active)
+{
+	memset(d, 0, sizeof(*d));
+	memcpy(d->magic, AVB_AB_MAGIC, AVB_AB_MAGIC_LEN);
+	d->version_major = AVB_AB_MAJOR_VERSION;
+	d->version_minor = AVB_AB_MINOR_VERSION;
+	d->slots[0].priority = active == SLOT_A ? AVB_AB_MAX_PRIORITY : AVB_AB_MAX_PRIORITY - 1;
+	d->slots[1].priority = active == SLOT_B ? AVB_AB_MAX_PRIORITY : AVB_AB_MAX_PRIORITY - 1;
+	d->slots[0].tries_remaining = AVB_AB_MAX_TRIES_REMAINING;
+	d->slots[1].tries_remaining = AVB_AB_MAX_TRIES_REMAINING;
+	d->crc32 = ab_crc(d);
+}
+
+/* Configured retry count of a slot (0 in misc means the default). */
+static uint8_t slot_max_tries(const AvbABData *d, int slot)
+{
+	return d->reserved2[slot & 1] ? d->reserved2[slot & 1] : AVB_AB_MAX_TRIES_REMAINING;
+}
+
+static int parse_tries(const char *s, int allow_zero)
+{
+	char *end;
+	long n;
+
+	if (!s || !*s)
+		return -1;
+	n = strtol(s, &end, 0);
+	if (*end || n < (allow_zero ? 0 : 1) || n > 255)
+		return -1;
+	return (int)n;
+}
+
+static bool slot_bootable(const AvbABSlotData *s)
+{
+	return s->priority > 0 && (s->successful_boot || s->tries_remaining > 0);
+}
+
+/* Same decision as u-boot cvi_ab_select_slot(). */
+static int ab_pick(const AvbABData *d)
+{
+	bool a = slot_bootable(&d->slots[0]);
+	bool b = slot_bootable(&d->slots[1]);
+
+	if (a && b)
+		return d->slots[1].priority > d->slots[0].priority ? SLOT_B : SLOT_A;
+	if (a)
+		return SLOT_A;
+	if (b)
+		return SLOT_B;
+	return SLOT_UNKNOWN;
+}
+
+static void ab_dump(const AvbABData *d)
+{
+	int i;
+
+	printf("version=%u.%u crc=%08x (%s)\n", d->version_major, d->version_minor,
+	       d->crc32, ab_valid(d) ? "valid" : "INVALID");
+	for (i = 0; i < 2; i++)
+		printf("slot %c: priority=%u tries_remaining=%u max_tries=%u successful_boot=%u%s\n",
+		       'a' + i, d->slots[i].priority, d->slots[i].tries_remaining,
+		       slot_max_tries(d, i), d->slots[i].successful_boot,
+		       slot_bootable(&d->slots[i]) ? "" : " (not bootable)");
+	i = ab_pick(d);
+	printf("next boot: %s\n", i == SLOT_UNKNOWN ? "none (u-boot default)" :
+	       (i == SLOT_A ? "a" : "b"));
+}
+
+static int current_slot(void)
+{
+	char cmdline[1024] = {0};
+	int fd = open("/proc/cmdline", O_RDONLY);
+	ssize_t len;
+
+	if (fd < 0)
+		return SLOT_UNKNOWN;
+	len = read(fd, cmdline, sizeof(cmdline) - 1);
+	close(fd);
+	if (len <= 0)
+		return SLOT_UNKNOWN;
+	if (strstr(cmdline, "slot_suffix=_a"))
+		return SLOT_A;
+	if (strstr(cmdline, "slot_suffix=_b"))
+		return SLOT_B;
+	/* no slot_suffix: derive from the ubi.mtd=/root= partition name */
+	if (strstr(cmdline, "rootfs_a"))
+		return SLOT_A;
+	if (strstr(cmdline, "rootfs_b"))
+		return SLOT_B;
+	return SLOT_UNKNOWN;
+}
+
+static int find_mtd_index(const char *part_name)
+{
+	FILE *fp = fopen("/proc/mtd", "r");
+	char line[256];
+	int index = -ENOENT;
+
+	if (!fp)
+		return -errno;
+	while (fgets(line, sizeof(line), fp)) {
+		unsigned int num;
+		char name[128];
+
+		if (sscanf(line, "mtd%u: %*x %*x \"%127[^\"]\"", &num, name) != 2)
+			continue;
+		if (strcmp(name, part_name) == 0) {
+			index = (int)num;
+			break;
+		}
+	}
+	fclose(fp);
+	return index;
+}
+
+struct misc_dev {
+	int fd;
+	struct mtd_info_user info;
+};
+
+static int misc_open(struct misc_dev *dev)
+{
+	char path[PATH_MAX];
+	int idx = find_mtd_index(MISC_MTD_NAME);
+
+	if (idx < 0) {
+		fprintf(stderr, "cannot find mtd partition \"%s\"\n", MISC_MTD_NAME);
+		return -1;
+	}
+	snprintf(path, sizeof(path), "/dev/mtd%d", idx);
+	dev->fd = open(path, O_RDWR);
+	if (dev->fd < 0) {
+		fprintf(stderr, "open %s: %s\n", path, strerror(errno));
+		return -1;
+	}
+	if (ioctl(dev->fd, MEMGETINFO, &dev->info) < 0) {
+		fprintf(stderr, "MEMGETINFO %s: %s\n", path, strerror(errno));
+		close(dev->fd);
+		return -1;
+	}
+	return 0;
+}
+
+static int is_bad(struct misc_dev *dev, off_t off)
+{
+	loff_t blk = off;
+	int ret = ioctl(dev->fd, MEMGETBADBLOCK, &blk);
+
+	return ret < 0 ? 1 : ret;
+}
+
+static int read_at(struct misc_dev *dev, off_t off, void *buf, size_t len)
+{
+	if (lseek(dev->fd, off, SEEK_SET) < 0)
+		return -errno;
+	return read(dev->fd, buf, len) == (ssize_t)len ? 0 : -EIO;
+}
+
+/*
+ * Find the block holding valid data (returns 1, fills *data) or the first
+ * good block (returns 0). *block gets the block offset.
+ */
+static int find_block(struct misc_dev *dev, off_t *block, AvbABData *data)
+{
+	off_t off, first_good = -1;
+	AvbABData tmp;
+
+	for (off = 0; off < (off_t)dev->info.size; off += dev->info.erasesize) {
+		if (is_bad(dev, off))
+			continue;
+		if (first_good < 0)
+			first_good = off;
+		if (read_at(dev, off + AVB_AB_OFFSET_IN_MISC, &tmp, sizeof(tmp)))
+			continue;
+		if (ab_valid(&tmp)) {
+			*block = off;
+			if (data)
+				*data = tmp;
+			return 1;
+		}
+	}
+	if (first_good < 0)
+		return -ENOSPC;
+	*block = first_good;
+	return 0;
+}
+
+static int misc_load(struct misc_dev *dev, AvbABData *data)
+{
+	off_t block;
+	int ret = find_block(dev, &block, data);
+
+	if (ret < 0)
+		return ret;
+	return ret == 1 ? 0 : -ENOENT;
+}
+
+static int misc_store(struct misc_dev *dev, AvbABData *data)
+{
+	off_t block;
+	uint8_t *page;
+	int ret;
+
+	data->crc32 = ab_crc(data);
+	ret = find_block(dev, &block, NULL);
+	if (ret < 0)
+		return ret;
+	page = malloc(dev->info.writesize);
+	if (!page)
+		return -ENOMEM;
+	memset(page, 0xff, dev->info.writesize);
+	memcpy(page + AVB_AB_OFFSET_IN_MISC, data, sizeof(*data));
+
+	ret = -EIO;
+	for (; block < (off_t)dev->info.size; block += dev->info.erasesize) {
+		struct erase_info_user erase = { .start = block, .length = dev->info.erasesize };
+		AvbABData chk;
+
+		if (is_bad(dev, block))
+			continue;
+		if (ioctl(dev->fd, MEMERASE, &erase) < 0) {
+			loff_t bad = block;
+
+			fprintf(stderr, "erase misc block 0x%llx failed: %s, mark bad\n",
+				(long long)block, strerror(errno));
+			ioctl(dev->fd, MEMSETBADBLOCK, &bad);
+			continue;
+		}
+		if (lseek(dev->fd, block, SEEK_SET) < 0 ||
+		    write(dev->fd, page, dev->info.writesize) != (ssize_t)dev->info.writesize) {
+			fprintf(stderr, "write misc block 0x%llx failed: %s\n",
+				(long long)block, strerror(errno));
+			continue;
+		}
+		if (read_at(dev, block + AVB_AB_OFFSET_IN_MISC, &chk, sizeof(chk)) == 0 &&
+		    memcmp(&chk, data, sizeof(chk)) == 0) {
+			ret = 0;
+			break;
+		}
+		fprintf(stderr, "verify misc block 0x%llx failed\n", (long long)block);
+	}
+	free(page);
+	return ret;
+}
+
+static int parse_slot(const char *s)
+{
+	if (!s)
+		return SLOT_UNKNOWN;
+	if (!strcasecmp(s, "a") || !strcmp(s, "0") || !strcmp(s, "_a"))
+		return SLOT_A;
+	if (!strcasecmp(s, "b") || !strcmp(s, "1") || !strcmp(s, "_b"))
+		return SLOT_B;
+	return SLOT_UNKNOWN;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [spinand] <command>\n"
+		"  boot_ok [N]         mark the running slot as booted OK: refill tries to its\n"
+		"                      configured count (or N once), default command\n"
+		"  dump                print the A/B metadata\n"
+		"  get_active          print the slot u-boot will boot next (a|b)\n"
+		"  set_active a|b [N]  make slot a|b the active one, optionally with N retries\n"
+		"                      (takes effect on reboot)\n"
+		"  set_tries a|b N     set the retry count of slot a|b to N (1..255, 0 = disable\n"
+		"                      the slot); also becomes its refill value for boot_ok\n"
+		"  reinit              restore default metadata (active slot %c, %d retries)\n",
+		prog, AB_DEFAULT_SLOT == SLOT_B ? 'b' : 'a', AVB_AB_MAX_TRIES_REMAINING);
+}
+
+int main(int argc, char *argv[])
+{
+	struct misc_dev dev;
+	AvbABData data;
+	const char *cmd = "boot_ok";
+	int argi = 1, ret, slot;
+
+	if (argi < argc && (!strcmp(argv[argi], "spinand") || !strcmp(argv[argi], "nand")))
+		argi++;
+	if (argi < argc && !strcmp(argv[argi], "emmc")) {
+		fprintf(stderr, "emmc is not supported on this board\n");
+		return 1;
+	}
+	if (argi < argc)
+		cmd = argv[argi++];
+	if (!strcmp(cmd, "-h") || !strcmp(cmd, "--help") || !strcmp(cmd, "help")) {
+		usage(argv[0]);
+		return 0;
+	}
+
+	if (misc_open(&dev))
+		return 1;
+
+	ret = misc_load(&dev, &data);
+	if (ret) {
+		fprintf(stderr, "misc A/B data invalid (%d), using defaults\n", ret);
+		ab_defaults(&data, AB_DEFAULT_SLOT);
+	}
+
+	if (!strcmp(cmd, "dump")) {
+		ab_dump(&data);
+		ret = 0;
+	} else if (!strcmp(cmd, "get_active")) {
+		slot = ab_pick(&data);
+		printf("%s\n", slot == SLOT_UNKNOWN ? "none" : (slot == SLOT_A ? "a" : "b"));
+		ret = slot == SLOT_UNKNOWN;
+	} else if (!strcmp(cmd, "boot_ok")) {
+		int tries;
+
+		slot = current_slot();
+		if (slot == SLOT_UNKNOWN) {
+			fprintf(stderr, "cannot detect the running slot from /proc/cmdline\n");
+			close(dev.fd);
+			return 1;
+		}
+		tries = argi < argc ? parse_tries(argv[argi], 0) : slot_max_tries(&data, slot);
+		if (tries < 0) {
+			usage(argv[0]);
+			close(dev.fd);
+			return 1;
+		}
+		if (!ret && data.slots[slot].tries_remaining == tries &&
+		    data.slots[slot].priority > 0) {
+			printf("slot %c already OK (tries=%d), nothing to do\n", 'a' + slot, tries);
+			ret = 0;
+		} else {
+			data.slots[slot].tries_remaining = tries;
+			if (data.slots[slot].priority == 0)
+				data.slots[slot].priority = AVB_AB_MAX_PRIORITY - 1;
+			ret = misc_store(&dev, &data);
+			printf("slot %c boot ok: tries refilled to %d%s\n", 'a' + slot, tries,
+			       ret ? " (write FAILED)" : "");
+		}
+	} else if (!strcmp(cmd, "set_active")) {
+		int tries = -1;
+
+		slot = parse_slot(argi < argc ? argv[argi] : NULL);
+		if (slot != SLOT_UNKNOWN) {
+			argi++;
+			tries = argi < argc ? parse_tries(argv[argi], 0) : slot_max_tries(&data, slot);
+		}
+		if (slot == SLOT_UNKNOWN || tries < 0) {
+			usage(argv[0]);
+			ret = 1;
+		} else {
+			data.slots[slot].priority = AVB_AB_MAX_PRIORITY;
+			data.slots[slot].tries_remaining = tries;
+			data.slots[slot].successful_boot = 0;
+			data.reserved2[slot] = tries;
+			data.slots[slot ^ 1].priority = AVB_AB_MAX_PRIORITY - 1;
+			ret = misc_store(&dev, &data);
+			printf("active slot -> %c, %d retries%s\n", 'a' + slot, tries,
+			       ret ? " (write FAILED)" : ", reboot to apply");
+		}
+	} else if (!strcmp(cmd, "set_tries")) {
+		int tries = -1;
+
+		slot = parse_slot(argi < argc ? argv[argi] : NULL);
+		if (slot != SLOT_UNKNOWN) {
+			argi++;
+			tries = parse_tries(argi < argc ? argv[argi] : NULL, 1);
+		}
+		if (slot == SLOT_UNKNOWN || tries < 0) {
+			usage(argv[0]);
+			ret = 1;
+		} else {
+			data.slots[slot].tries_remaining = tries;
+			if (tries)
+				data.reserved2[slot] = tries;
+			ret = misc_store(&dev, &data);
+			printf("slot %c tries -> %d%s%s\n", 'a' + slot, tries,
+			       tries ? "" : " (slot disabled until set_tries/set_active)",
+			       ret ? " (write FAILED)" : "");
+		}
+	} else if (!strcmp(cmd, "reinit")) {
+		ab_defaults(&data, AB_DEFAULT_SLOT);
+		ret = misc_store(&dev, &data);
+		printf("misc A/B data reinitialised%s\n", ret ? " (write FAILED)" : "");
+	} else {
+		usage(argv[0]);
+		ret = 1;
+	}
+
+	close(dev.fd);
+	return ret ? 1 : 0;
+}
diff --git a/tools/common/update_misc/update_misc.h b/tools/common/update_misc/update_misc.h
new file mode 100644
index 0000000000000000000000000000000000000000..fc5709cdfdac92c9b0ef3dd794f508f7a1a1abae
--- /dev/null
+++ b/tools/common/update_misc/update_misc.h
@@ -0,0 +1,46 @@
+/*
+ * A/B metadata stored in the "misc" partition.
+ * Must stay in sync with u-boot include/cvi_boot_mode.h and gen_abmisc.py.
+ */
+#ifndef __UPDATE_MISC_H__
+#define __UPDATE_MISC_H__
+
+#include <stdint.h>
+
+#define AVB_AB_MAGIC "\0AB0"
+#define AVB_AB_MAGIC_LEN 4
+#define AVB_AB_MAJOR_VERSION 1
+#define AVB_AB_MINOR_VERSION 0
+#define AVB_AB_MAX_PRIORITY 15
+#define AVB_AB_MAX_TRIES_REMAINING 3
+#define AVB_AB_OFFSET_IN_MISC 0
+
+#ifndef AB_DEFAULT_SLOT
+#define AB_DEFAULT_SLOT 0
+#endif
+
+#pragma pack(4)
+typedef struct AvbABSlotData {
+	uint8_t priority;	/* 0 = never boot, 15 = highest */
+	uint8_t tries_remaining;	/* boots left before the slot is given up */
+	uint8_t successful_boot;	/* 1 = tries are not consumed */
+	uint8_t reserved[1];
+} AvbABSlotData;
+
+typedef struct AvbABData {
+	uint8_t magic[AVB_AB_MAGIC_LEN];
+	uint8_t version_major;
+	uint8_t version_minor;
+	uint8_t reserved1[2];
+	AvbABSlotData slots[2];	/* [0] = A, [1] = B */
+	/*
+	 * reserved2[0] / [1]: configured retry count (max tries) of slot A / B,
+	 * written by "update_misc set_tries"; 0 = AVB_AB_MAX_TRIES_REMAINING.
+	 * boot_ok refills tries_remaining to this value. u-boot ignores it.
+	 */
+	uint8_t reserved2[12];
+	uint32_t crc32;	/* zlib crc32 of the 28 bytes above, little endian */
+} AvbABData;
+#pragma pack()
+
+#endif /* __UPDATE_MISC_H__ */
-- 
2.25.1

