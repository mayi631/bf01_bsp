diff --git a/Kconfig b/Kconfig
index 68d81be6e3a5ce741e5aae3f114f7882cf3982fb..456f911a807561cb382303fbcc507064adeba0cb 100644
--- a/Kconfig
+++ b/Kconfig
@@ -722,6 +722,31 @@ config ROOTFS_RW
 	help
 	  Enable rootfs with rw.
 
+config AB_SYSTEM
+	bool "Enable ab system"
+	default n
+	help
+	  A/B boot controlled by the "misc" partition. u-boot SPL reads the
+	  AvbABData metadata (slot priority / tries_remaining / successful_boot)
+	  from the misc partition, picks the bootable slot with the highest
+	  priority, decrements its tries and falls back to the other slot when
+	  the kernel cannot be loaded. Linux refills the tries with
+	  /bin/update_misc (boot_ok) and switches slots with
+	  "update_misc spinand set_active a|b". The partition.xml must define
+	  boot_a, boot_b, rootfs_a, rootfs_b and misc; misc.spinand is packed
+	  by pack_misc (make misc) with the default slot from "Enable b system".
+
+config B_SYSTEM
+	bool "Enable b system"
+	default n
+	help
+	  Prefer the B slot (boot_b/rootfs_b) instead of the default A slot
+	  (boot_a/rootfs_a). Without AB_SYSTEM the slot is fixed at build time
+	  in u-boot (SPL fast boot and nandboot). With AB_SYSTEM it is the
+	  initial/fallback slot: misc.spinand and a re-initialised misc give
+	  slot B the higher priority. The partition.xml must define boot_a,
+	  boot_b, rootfs_a and rootfs_b; both slots are always packed.
+
 endmenu
 
 menu "Turnkey options"
