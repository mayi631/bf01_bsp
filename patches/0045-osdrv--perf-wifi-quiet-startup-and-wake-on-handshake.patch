@@ -1667,12 +1667,17 @@
 		#ifdef ATBM_BF01_STARTUP_RETRY
 		unsigned long startup_started = jiffies;
 		unsigned long startup_deadline = startup_started + msecs_to_jiffies(1000);
-		atbm_printk_always("WSM handshake attempt: timeout_ms=1000; retry worker owns startup\n");
+		long startup_remaining;
+		atbm_printk_init("WSM handshake attempt: timeout_ms=1000; retry worker owns startup\n");
 		#else
 		int loop =0;
 		atbm_printk_always("mdelay wait wsm_startup_done  !!\n");
 		#endif
+		#ifdef ATBM_BF01_STARTUP_RETRY
+		while (!smp_load_acquire(&hw_priv->wsm_caps.firmwareReady)) {
+		#else
 		while(hw_priv->wsm_caps.firmwareReady !=1){
+		#endif
 			#ifdef ATBM_BF01_STARTUP_RETRY
 			if (hw_priv->sbus_ops->startup_cancelled(hw_priv->sbus_priv)) {
 				err = -ESHUTDOWN;
@@ -1684,9 +1689,15 @@
 					err, jiffies_to_msecs(jiffies - startup_started));
 				goto err3;
 			}
-			msleep(20);
+			startup_remaining = startup_deadline - jiffies;
+			if (startup_remaining > 0)
+				wait_event_timeout(hw_priv->wsm_cmd_wq,
+					smp_load_acquire(&hw_priv->wsm_caps.firmwareReady) ||
+					hw_priv->sbus_ops->startup_cancelled(hw_priv->sbus_priv) ||
+					hw_priv->sbus_ops->startup_status(hw_priv->sbus_priv),
+					min_t(long, startup_remaining, msecs_to_jiffies(20)));
 			if (time_after_eq(jiffies, startup_deadline) &&
-			    !READ_ONCE(hw_priv->wsm_caps.firmwareReady)) {
+			    !smp_load_acquire(&hw_priv->wsm_caps.firmwareReady)) {
 				atbm_printk_err("WSM handshake attempt expired: elapsed_ms=%u\n",
 					jiffies_to_msecs(jiffies - startup_started));
 				err = -ETIMEDOUT;
@@ -1734,7 +1745,7 @@
 			}
 		}
 		#ifdef ATBM_BF01_STARTUP_RETRY
-		atbm_printk_always("WSM handshake accepted: elapsed_ms=%u\n",
+		pr_info(ATBM_TAG "WSM handshake accepted: elapsed_ms=%u\n",
 			jiffies_to_msecs(jiffies - startup_started));
 		err = hw_priv->sbus_ops->startup_status(hw_priv->sbus_priv);
 		#endif
