+/*
+ * 1920x1440 WDR timing. HTS must stay at the vendor value 550 (HB < 550 breaks
+ * the 2568-wide readout, see project/bf01/debug/gc4683-wdr-1920x1440-20261030).
+ * VTS is the frame length at the nominal 30 fps; cmos_fps_set scales it by
+ * 30 / s32Framerate, so raising VTS lowers the real frame rate (48000 / VTS_reg).
+ */
+#define GC4683_1920X1440P30_WDR_VTS 1600U
+#define GC4683_1920X1440P30_WDR_HTS 550U
+/*
+ * Short-exposure guard (lines). The SEF readout trails the LEF by T1, so with
+ * T1 = VTS - 1440 - 8 the SEF frame ends only 8 lines (~166 us @ 30 fps) before
+ * the next SOF and the ISP FE/BE HDR hand-off loses the SEF frame (FE ch0/ch1
+ * frame counters diverge, event thread times out forever). Reserve extra lines
+ * so the SEF always finishes >= (8 + GUARD) lines before the next frame.
+ */
+#define GC4683_1920X1440P30_WDR_SEXP_GUARD 80U
+#define GC4683_1920X1440P30_WDR_SEXP_MAX \
+	(GC4683_1920X1440P30_WDR_VTS - 1440U - 8U - GC4683_1920X1440P30_WDR_SEXP_GUARD)
+
+#if GC4683_1920X1440P30_WDR_VTS <= 1440U + 8U + GC4683_1920X1440P30_WDR_SEXP_GUARD || \
+	GC4683_1920X1440P30_WDR_VTS > 16383U || \
+	GC4683_1920X1440P30_WDR_HTS == 0U || \
+	GC4683_1920X1440P30_WDR_HTS > 65535U
+#error "GC4683 1920x1440 WDR timing exceeds register or exposure limits"
+#endif
+
 typedef struct _GC4683_STATE_S {
 	CVI_U32		u32Sexp_MAX;
 } GC4683_STATE_S;
