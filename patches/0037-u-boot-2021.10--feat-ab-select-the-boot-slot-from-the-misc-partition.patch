diff --git a/include/cvi_boot_mode.h b/include/cvi_boot_mode.h
new file mode 100644
index 0000000000000000000000000000000000000000..89812086f34867e31b75cdc9b0ffa14299f99d3f
--- /dev/null
+++ b/include/cvi_boot_mode.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * A/B boot slot selection controlled by the "misc" partition.
+ * The on-flash record (AvbABData) must stay in sync with
+ * build/tools/common/update_misc/update_misc.h and gen_abmisc.py.
+ */
+#ifndef __CVI_BOOT_MODE_H__
+#define __CVI_BOOT_MODE_H__
+
+#include <linux/types.h>
+
+#define AVB_AB_MAGIC "\0AB0"
+#define AVB_AB_MAGIC_LEN 4
+#define AVB_AB_MAJOR_VERSION 1
+#define AVB_AB_MINOR_VERSION 0
+#define AVB_AB_MAX_PRIORITY 15
+#define AVB_AB_MAX_TRIES_REMAINING 3
+#define AVB_AB_OFFSET_IN_MISC 0
+
+enum cvi_ab_slot {
+	CVI_AB_SLOT_A = 0,
+	CVI_AB_SLOT_B = 1,
+};
+
+#pragma pack(4)
+typedef struct AvbABSlotData {
+	uint8_t priority;		/* 0 = never boot, 15 = highest */
+	uint8_t tries_remaining;	/* boots left before the slot is given up */
+	uint8_t successful_boot;	/* 1 = tries are not consumed */
+	uint8_t reserved[1];
+} AvbABSlotData;
+
+typedef struct AvbABData {
+	uint8_t magic[AVB_AB_MAGIC_LEN];
+	uint8_t version_major;
+	uint8_t version_minor;
+	uint8_t reserved1[2];
+	AvbABSlotData slots[2];		/* [0] = A, [1] = B */
+	/* reserved2[0]/[1]: per slot retry count set by Linux update_misc, not used here */
+	uint8_t reserved2[12];
+	uint32_t crc32;			/* crc32 of the 28 bytes above */
+} AvbABData;
+#pragma pack()
+
+/* Read misc, pick the slot to boot (decrements its tries) and remember it. */
+int cvi_ab_select_slot(void);
+/* Slot chosen by cvi_ab_select_slot(), or the build default before that. */
+int cvi_ab_current_slot(void);
+void cvi_ab_set_current_slot(int slot);
+/* Slot could not be booted: tries_remaining = 0 so the other slot is used. */
+int cvi_ab_mark_unbootable(int slot);
+/* Give slot the highest priority and fresh tries. */
+int cvi_ab_set_active(int slot);
+int cvi_ab_reinit(void);
+int cvi_ab_load(AvbABData *out);
+void cvi_ab_dump(void);
+/* Kernel root arguments for a slot (ROOTARGSA / ROOTARGSB). */
+const char *cvi_ab_rootargs(int slot);
+/* Full SPL bootargs for the current slot. */
+const char *cvi_ab_spl_bootargs(void);
+
+#endif /* __CVI_BOOT_MODE_H__ */
