--- a/common/spl/spl_nand.c
+++ b/common/spl/spl_nand.c
@@ -13,6 +13,9 @@
 #include <nand.h>
 #include <linux/libfdt_env.h>
 #include <fdt.h>
+#ifdef CONFIG_AB_SYSTEM
+#include "cvi_boot_mode.h"
+#endif
 
 uint32_t __weak spl_nand_get_uboot_raw_page(void)
 {
@@ -167,7 +170,35 @@ static int spl_nand_load_image(struct spl_image_info *spl_image,
 #endif
 #ifdef DOUBLESDK
 		err = spl_nand_load_element(spl_image, SPL_BOOT_BAK_PART_OFFSET, header);
+#elif defined(CONFIG_AB_SYSTEM)
+	{
+		/* A/B slot from the misc partition; fall back to the other slot */
+		int slot = cvi_ab_select_slot();
+		ulong part_offset = slot == CVI_AB_SLOT_B ?
+				    SPL_BOOT_B_PART_OFFSET : SPL_BOOT_PART_OFFSET;
+
+		printf("spl: boot slot %c, kernel from 0x%lx\n",
+		       slot == CVI_AB_SLOT_B ? 'B' : 'A', part_offset);
+		err = spl_nand_load_element(spl_image, part_offset, header);
+		if (err) {
+			int other = slot ^ 1;
+
+			printf("spl: slot %c kernel load failed (%d), mark unbootable, try slot %c\n",
+			       slot == CVI_AB_SLOT_B ? 'B' : 'A', err,
+			       other == CVI_AB_SLOT_B ? 'B' : 'A');
+			cvi_ab_mark_unbootable(slot);
+			cvi_ab_set_current_slot(other);
+			part_offset = other == CVI_AB_SLOT_B ?
+				      SPL_BOOT_B_PART_OFFSET : SPL_BOOT_PART_OFFSET;
+			err = spl_nand_load_element(spl_image, part_offset, header);
+		}
+	}
+#elif defined(CONFIG_B_SYSTEM)
+		/* "Enable b system": fast boot loads the kernel from boot_b */
+		printf("spl: boot slot B, kernel from boot_b @ 0x%x\n", SPL_BOOT_B_PART_OFFSET);
+		err = spl_nand_load_element(spl_image, SPL_BOOT_B_PART_OFFSET, header);
 #else
+		printf("spl: boot slot A, kernel from 0x%x\n", SPL_BOOT_PART_OFFSET);
 		err = spl_nand_load_element(spl_image, SPL_BOOT_PART_OFFSET, header);
 #endif
 		return err;
