diff --git a/cmd/cvi_boot_mode.c b/cmd/cvi_boot_mode.c
new file mode 100644
index 0000000000000000000000000000000000000000..21d59ddceb98b8323a9c8a904f21c002ef5e9a54
--- /dev/null
+++ b/cmd/cvi_boot_mode.c
@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * A/B boot slot selection controlled by the "misc" partition (SPI NAND).
+ *
+ * The misc partition (AB_MISC_OFFSET/AB_MISC_SIZE from cvipart.h) is used
+ * as raw NAND blocks: the AvbABData record sits at offset 0 of the first
+ * good block that holds a valid record, the rest of the block is 0xFF.
+ * Bad or worn blocks are skipped, so the partition should span several
+ * erase blocks. The same code runs in the SPL (fast boot path, where it
+ * decides which boot_a/boot_b partition to load the kernel from) and in
+ * u-boot proper (ab_select command used by nandboot, plus debug commands).
+ *
+ * Enabled by CONFIG_AB_SYSTEM ("Enable ab system" in the SDK menuconfig);
+ * CONFIG_B_SYSTEM ("Enable b system") selects the default/fallback slot.
+ */
+#include <common.h>
+#include <command.h>
+#include <env.h>
+#include <malloc.h>
+#include <nand.h>
+#include <linux/mtd/mtd.h>
+#include <u-boot/crc.h>
+#include "cvipart.h"
+#include "cvi_boot_mode.h"
+
+#if defined(CONFIG_AB_SYSTEM) && defined(AB_MISC_OFFSET)
+
+#ifdef CONFIG_B_SYSTEM
+#define AB_DEFAULT_SLOT CVI_AB_SLOT_B
+#else
+#define AB_DEFAULT_SLOT CVI_AB_SLOT_A
+#endif
+
+#define AB_MISC_END ((loff_t)AB_MISC_OFFSET + AB_MISC_SIZE)
+
+#ifdef CONFIG_SPL_BUILD
+struct mtd_info *cvsnfc_spl_get_mtd(void);
+#endif
+
+static struct mtd_info *ab_mtd;
+static int ab_current = -1;
+
+static char slot_name(int slot)
+{
+	return slot == CVI_AB_SLOT_B ? 'B' : 'A';
+}
+
+static struct mtd_info *ab_get_mtd(void)
+{
+	if (ab_mtd)
+		return ab_mtd;
+#ifdef CONFIG_SPL_BUILD
+	ab_mtd = cvsnfc_spl_get_mtd();
+#else
+	ab_mtd = get_nand_dev_by_index(0);
+#endif
+	if (!ab_mtd || !ab_mtd->erasesize || !ab_mtd->writesize) {
+		printf("ab: nand not ready\n");
+		ab_mtd = NULL;
+	} else if (AB_MISC_SIZE < ab_mtd->erasesize) {
+		printf("ab: misc partition smaller than one block\n");
+		ab_mtd = NULL;
+	}
+	return ab_mtd;
+}
+
+static uint32_t ab_crc(const AvbABData *d)
+{
+	return crc32(0, (const uint8_t *)d, sizeof(*d) - sizeof(d->crc32));
+}
+
+static int ab_valid(const AvbABData *d)
+{
+	return !memcmp(d->magic, AVB_AB_MAGIC, AVB_AB_MAGIC_LEN) &&
+	       ab_crc(d) == d->crc32;
+}
+
+static void ab_defaults(AvbABData *d, int active)
+{
+	memset(d, 0, sizeof(*d));
+	memcpy(d->magic, AVB_AB_MAGIC, AVB_AB_MAGIC_LEN);
+	d->version_major = AVB_AB_MAJOR_VERSION;
+	d->version_minor = AVB_AB_MINOR_VERSION;
+	d->slots[0].priority = active == CVI_AB_SLOT_A ?
+			       AVB_AB_MAX_PRIORITY : AVB_AB_MAX_PRIORITY - 1;
+	d->slots[1].priority = active == CVI_AB_SLOT_B ?
+			       AVB_AB_MAX_PRIORITY : AVB_AB_MAX_PRIORITY - 1;
+	d->slots[0].tries_remaining = AVB_AB_MAX_TRIES_REMAINING;
+	d->slots[1].tries_remaining = AVB_AB_MAX_TRIES_REMAINING;
+	d->crc32 = ab_crc(d);
+}
+
+static int ab_read(struct mtd_info *mtd, loff_t from, size_t len, void *buf)
+{
+	size_t retlen = 0;
+	int ret = mtd_read(mtd, from, len, &retlen, buf);
+
+	if (ret && !mtd_is_bitflip(ret))
+		return ret;
+	return retlen == len ? 0 : -EIO;
+}
+
+/*
+ * Find the block holding a valid record (returns 1 and fills *data) or
+ * the first good block (returns 0). *block gets the block offset.
+ */
+static int ab_find_block(struct mtd_info *mtd, loff_t *block, AvbABData *data)
+{
+	loff_t off, first_good = -1;
+	AvbABData tmp;
+
+	for (off = AB_MISC_OFFSET; off < AB_MISC_END; off += mtd->erasesize) {
+		if (mtd_block_isbad(mtd, off))
+			continue;
+		if (first_good < 0)
+			first_good = off;
+		if (ab_read(mtd, off + AVB_AB_OFFSET_IN_MISC, sizeof(tmp), &tmp))
+			continue;
+		if (ab_valid(&tmp)) {
+			*block = off;
+			if (data)
+				*data = tmp;
+			return 1;
+		}
+	}
+	if (first_good < 0)
+		return -ENOSPC;
+	*block = first_good;
+	return 0;
+}
+
+int cvi_ab_load(AvbABData *out)
+{
+	struct mtd_info *mtd = ab_get_mtd();
+	loff_t block;
+	int ret;
+
+	if (!mtd)
+		return -ENODEV;
+	ret = ab_find_block(mtd, &block, out);
+	if (ret < 0)
+		return ret;
+	return ret == 1 ? 0 : -ENOENT;
+}
+
+static int ab_store(AvbABData *data)
+{
+	struct mtd_info *mtd = ab_get_mtd();
+	struct erase_info instr;
+	loff_t block;
+	size_t retlen;
+	u8 *page;
+	int ret;
+
+	if (!mtd)
+		return -ENODEV;
+	data->crc32 = ab_crc(data);
+	ret = ab_find_block(mtd, &block, NULL);
+	if (ret < 0)
+		return ret;
+
+	page = malloc(mtd->writesize);
+	if (!page)
+		return -ENOMEM;
+	memset(page, 0xff, mtd->writesize);
+	memcpy(page + AVB_AB_OFFSET_IN_MISC, data, sizeof(*data));
+
+	ret = -EIO;
+	for (; block < AB_MISC_END; block += mtd->erasesize) {
+		AvbABData chk;
+
+		if (mtd_block_isbad(mtd, block))
+			continue;
+		memset(&instr, 0, sizeof(instr));
+		instr.mtd = mtd;
+		instr.addr = block;
+		instr.len = mtd->erasesize;
+		if (mtd_erase(mtd, &instr)) {
+			printf("ab: erase misc block 0x%lx failed, mark bad\n",
+			       (ulong)block);
+			mtd_block_markbad(mtd, block);
+			continue;
+		}
+		retlen = 0;
+		if (mtd_write(mtd, block, mtd->writesize, &retlen, page) ||
+		    retlen != mtd->writesize) {
+			printf("ab: write misc block 0x%lx failed\n", (ulong)block);
+			continue;
+		}
+		if (!ab_read(mtd, block + AVB_AB_OFFSET_IN_MISC, sizeof(chk), &chk) &&
+		    !memcmp(&chk, data, sizeof(chk))) {
+			ret = 0;
+			break;
+		}
+		printf("ab: verify misc block 0x%lx failed\n", (ulong)block);
+	}
+	free(page);
+	if (ret)
+		printf("ab: store misc failed (%d)\n", ret);
+	return ret;
+}
+
+static int slot_bootable(const AvbABSlotData *s)
+{
+	return s->priority > 0 && (s->successful_boot || s->tries_remaining > 0);
+}
+
+static int ab_pick(const AvbABData *d)
+{
+	int a = slot_bootable(&d->slots[0]);
+	int b = slot_bootable(&d->slots[1]);
+
+	if (a && b)
+		return d->slots[1].priority > d->slots[0].priority ?
+		       CVI_AB_SLOT_B : CVI_AB_SLOT_A;
+	if (a)
+		return CVI_AB_SLOT_A;
+	if (b)
+		return CVI_AB_SLOT_B;
+	return -1;
+}
+
+int cvi_ab_select_slot(void)
+{
+	AvbABData d;
+	int slot, ret;
+
+	ret = cvi_ab_load(&d);
+	if (ret) {
+		printf("ab: misc A/B data invalid (%d), init defaults\n", ret);
+		ab_defaults(&d, AB_DEFAULT_SLOT);
+		ab_store(&d);
+	}
+
+	slot = ab_pick(&d);
+	if (slot < 0) {
+		slot = AB_DEFAULT_SLOT;
+		printf("ab: no bootable slot, fallback to %c\n", slot_name(slot));
+	} else if (!d.slots[slot].successful_boot &&
+		   d.slots[slot].tries_remaining > 0) {
+		d.slots[slot].tries_remaining--;
+		ab_store(&d);
+	}
+
+	printf("ab: A prio=%u tries=%u ok=%u | B prio=%u tries=%u ok=%u -> boot slot %c\n",
+	       d.slots[0].priority, d.slots[0].tries_remaining, d.slots[0].successful_boot,
+	       d.slots[1].priority, d.slots[1].tries_remaining, d.slots[1].successful_boot,
+	       slot_name(slot));
+	ab_current = slot;
+	return slot;
+}
+
+int cvi_ab_current_slot(void)
+{
+	return ab_current < 0 ? AB_DEFAULT_SLOT : ab_current;
+}
+
+void cvi_ab_set_current_slot(int slot)
+{
+	ab_current = slot == CVI_AB_SLOT_B ? CVI_AB_SLOT_B : CVI_AB_SLOT_A;
+}
+
+int cvi_ab_mark_unbootable(int slot)
+{
+	AvbABData d;
+
+	if (cvi_ab_load(&d))
+		return -ENOENT;
+	d.slots[slot & 1].tries_remaining = 0;
+	d.slots[slot & 1].successful_boot = 0;
+	return ab_store(&d);
+}
+
+int cvi_ab_set_active(int slot)
+{
+	AvbABData d;
+
+	slot &= 1;
+	if (cvi_ab_load(&d))
+		ab_defaults(&d, slot);
+	d.slots[slot].priority = AVB_AB_MAX_PRIORITY;
+	d.slots[slot].tries_remaining = AVB_AB_MAX_TRIES_REMAINING;
+	d.slots[slot].successful_boot = 0;
+	d.slots[slot ^ 1].priority = AVB_AB_MAX_PRIORITY - 1;
+	return ab_store(&d);
+}
+
+int cvi_ab_reinit(void)
+{
+	AvbABData d;
+
+	ab_defaults(&d, AB_DEFAULT_SLOT);
+	return ab_store(&d);
+}
+
+void cvi_ab_dump(void)
+{
+	AvbABData d;
+	int i, ret = cvi_ab_load(&d);
+
+	if (ret) {
+		printf("ab: no valid A/B data in misc (%d)\n", ret);
+		return;
+	}
+	printf("version=%u.%u crc=%08x\n", d.version_major, d.version_minor, d.crc32);
+	for (i = 0; i < 2; i++)
+		printf("slot %c: priority=%u tries_remaining=%u successful_boot=%u%s\n",
+		       slot_name(i), d.slots[i].priority, d.slots[i].tries_remaining,
+		       d.slots[i].successful_boot,
+		       slot_bootable(&d.slots[i]) ? "" : " (not bootable)");
+	i = ab_pick(&d);
+	printf("next boot: %s\n", i < 0 ? "none (default)" : (i ? "B" : "A"));
+}
+
+const char *cvi_ab_rootargs(int slot)
+{
+	return slot == CVI_AB_SLOT_B ? ROOTARGSB : ROOTARGSA;
+}
+
+const char *cvi_ab_spl_bootargs(void)
+{
+	static char buf[768];
+
+	snprintf(buf, sizeof(buf), "%s %s %s", PARTS,
+		 cvi_ab_rootargs(cvi_ab_current_slot()), CVI_SPL_BOOTAGRS_NOROOT);
+	return buf;
+}
+
+#ifndef CONFIG_SPL_BUILD
+/* Used by nandboot: pick the slot and export root/ab_boot_part to the env. */
+static int do_ab_select(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	int slot = cvi_ab_select_slot();
+
+	env_set("root", cvi_ab_rootargs(slot));
+	env_set("ab_boot_part", slot == CVI_AB_SLOT_B ? BOOT_DEV_B : BOOT_DEV);
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(ab_select, 1, 0, do_ab_select,
+	   "select A/B boot slot from misc, set root and ab_boot_part env",
+	   "");
+
+static int do_get_slot(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	AvbABData d;
+	int slot;
+
+	if (cvi_ab_load(&d))
+		return CMD_RET_FAILURE;
+	slot = ab_pick(&d);
+	if (slot < 0)
+		return CMD_RET_FAILURE;
+	printf("slot_suffix = %s\n", slot == CVI_AB_SLOT_B ? "_b" : "_a");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(get_slot, 1, 0, do_get_slot,
+	   "print the A/B slot that will boot next", "");
+
+static int do_set_slot(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	int slot;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+	if (!strcmp(argv[1], "a") || !strcmp(argv[1], "A") || !strcmp(argv[1], "_a"))
+		slot = CVI_AB_SLOT_A;
+	else if (!strcmp(argv[1], "b") || !strcmp(argv[1], "B") || !strcmp(argv[1], "_b"))
+		slot = CVI_AB_SLOT_B;
+	else
+		return CMD_RET_USAGE;
+	return cvi_ab_set_active(slot) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(set_slot, 2, 0, do_set_slot,
+	   "make A/B slot a|b the active one", "a|b");
+
+static int do_dump_abdata(struct cmd_tbl *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	cvi_ab_dump();
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(dump_abdata, 1, 0, do_dump_abdata,
+	   "dump the A/B metadata stored in misc", "");
+
+static int do_reinit_abdata(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	return cvi_ab_reinit() ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(reinit_abdata, 1, 0, do_reinit_abdata,
+	   "restore default A/B metadata in misc", "");
+#endif /* !CONFIG_SPL_BUILD */
+
+#endif /* CONFIG_AB_SYSTEM && AB_MISC_OFFSET */
